<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.Auth.LogoutPage"
             BackgroundColor="#0A0A0A"
             NavigationPage.HasNavigationBar="False"
             Title="Logout">

    <Grid VerticalOptions="Center" Padding="24">
        
        <!-- Card Container Logout -->
        <Border BackgroundColor="#141014"
                Stroke="#1E121F"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="28,32">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,12" Radius="24" Opacity="0.45" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="24">

                <!-- Header & Logout Icon -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="#1E121F"
                            Stroke="#D7192F"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 20"
                            HeightRequest="60"
                            WidthRequest="60"
                            HorizontalOptions="Center"
                            Margin="0,0,0,8">
                        <Label Text="&#xeba8;"
                               FontFamily="TablerIcons"
                               FontSize="28"
                               TextColor="#D7192F"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    
                    <Label Text="Keluar dari Aplikasi"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    
                    <Label Text="Apakah Anda yakin ingin keluar dari akun AumoFinance?"
                           FontSize="13"
                           TextColor="#D8D8D8"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Tombol Aksi Logout -->
                <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                    
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       Color="#FFFFFF"
                                       IsRunning="False"
                                       IsVisible="False"
                                       HeightRequest="36" />

                    <!-- Tombol Konfirmasi Logout (Red) -->
                    <Button x:Name="LogoutButton"
                            Text="Ya, Keluar"
                            Clicked="OnLogoutButtonClicked"
                            BackgroundColor="#D7192F"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="48">
                        <Button.Shadow>
                            <Shadow Brush="#D7192F" Offset="0,6" Radius="12" Opacity="0.35" />
                        </Button.Shadow>
                    </Button>

                    <!-- Tombol Batal (Outline/Transparent) -->
                    <Button x:Name="CancelButton"
                            Text="Batal"
                            Clicked="OnCancelButtonClicked"
                            BackgroundColor="Transparent"
                            TextColor="#D8D8D8"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="44" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
