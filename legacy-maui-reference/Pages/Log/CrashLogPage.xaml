<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.Log.CrashLogPage"
             Title="Crash Log Report"
             BackgroundColor="#0A0A0A">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="15">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="Aplikasi Mengalami Crash Sebelumnya" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#D7192F" />
            <Label Text="Teks di bawah ini dapat diblok dan disalin manual untuk analisa:" 
                   FontSize="13" 
                   TextColor="#D8D8D8" />
        </VerticalStackLayout>

        <!-- Container Log (Scrollable & Selectable) -->
        <Border Grid.Row="1" 
                BackgroundColor="#141014"
                StrokeShape="RoundRectangle 8" 
                Stroke="#1E121F" 
                Padding="5">
            <Editor x:Name="LogEditor"
                    IsReadOnly="True"
                    AutoSize="Disabled"
                    FontFamily="OpenSansRegular"
                    FontSize="12"
                    TextColor="#FFFFFF"
                    BackgroundColor="Transparent" />
        </Border>

        <!-- Tombol Aksi -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button Grid.Column="0" 
                    Text="Copy Log" 
                    Clicked="OnCopyClicked" 
                    BackgroundColor="#523363" 
                    TextColor="White" />
            
            <Button Grid.Column="1" 
                    Text="Tutup" 
                    Clicked="OnCloseClicked" 
                    BackgroundColor="#1E121F" 
                    TextColor="White" />
        </Grid>
    </Grid>
</ContentPage>
