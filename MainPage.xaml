<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.MainPage"
             Title="Aumo Finance"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label x:Name="PeriodLabel"
                   Text="Periode: -"
                   FontSize="14"
                   TextColor="#94A3B8" />

            <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="KAS SAAT INI" TextColor="#94A3B8" FontSize="12" FontAttributes="Bold" />
                    <Label x:Name="CashLabel"
                           Text="Rp 0"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="LABA BERSIH" TextColor="#94A3B8" FontSize="12" FontAttributes="Bold" />
                    <Label x:Name="NetIncomeLabel"
                           Text="Rp 0"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#22C55E" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="PENDAPATAN" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" />
                        <Label x:Name="RevenueLabel"
                               Text="Rp 0"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#38BDF8" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="BEBAN" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" />
                        <Label x:Name="ExpenseLabel"
                               Text="Rp 0"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EF4444" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="Muat Ulang Data"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="#334155"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50" />

            <Button Text="Input Jurnal Baru"
                    Clicked="OnInputJournalClicked"
                    BackgroundColor="#22C55E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
