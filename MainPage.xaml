<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.MainPage"
             Title="Aumo Finance"
             BackgroundColor="#0F172A">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <!-- Periode Badge -->
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    HorizontalOptions="Start"
                    Padding="12,6">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="📅" FontSize="12" VerticalOptions="Center" />
                    <Label x:Name="PeriodLabel"
                           Text="Periode: -"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#94A3B8"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Card Utama: Kas Saat Ini (Hero Card) -->
            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0.0" />
                        <GradientStop Color="#7C3AED" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#4F46E5" Offset="0,8" Radius="15" Opacity="0.3" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="💰" FontSize="16" />
                        <Label Text="KAS SAAT INI"
                               TextColor="#E0E7FF"
                               FontSize="12"
                               FontAttributes="Bold"
                               CharacterSpacing="1" />
                    </HorizontalStackLayout>
                    <Label x:Name="CashLabel"
                           Text="Rp 0"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- Card Laba Bersih -->
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                </Border.Shadow>

                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="LABA BERSIH"
                               TextColor="#94A3B8"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8" />
                        <Label x:Name="NetIncomeLabel"
                               Text="Rp 0"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#4ADE80" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="📈" FontSize="24" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Grid Pendapatan & Beban -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                
                <!-- Card Pendapatan -->
                <Border Grid.Column="0"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="🤑" FontSize="12" />
                            <Label Text="PENDAPATAN"
                                   TextColor="#94A3B8"
                                   FontSize="10"
                                   FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <Label x:Name="RevenueLabel"
                               Text="Rp 0"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#38BDF8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Card Beban -->
                <Border Grid.Column="1"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="💸" FontSize="12" />
                            <Label Text="BEBAN"
                                   TextColor="#94A3B8"
                                   FontSize="10"
                                   FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <Label x:Name="ExpenseLabel"
                               Text="Rp 0"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#F87171" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Action Buttons -->
            <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                
                <!-- Primary CTA Button -->
                <Button Text="➕  Input Jurnal Baru"
                        Clicked="OnInputJournalClicked"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="14"
                        HeightRequest="52">
                    <Button.Shadow>
                        <Shadow Brush="#10B981" Offset="0,4" Radius="8" Opacity="0.3" />
                    </Button.Shadow>
                </Button>

                <!-- Secondary Button (Fixed) -->
                <Button Text="🔄  Muat Ulang Data"
                        Clicked="OnRefreshClicked"
                        BackgroundColor="#1E293B"
                        BorderColor="#334155"
                        BorderWidth="1"
                        TextColor="#94A3B8"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="14"
                        HeightRequest="48" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
