<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Reports.TrialBalance.TrialBalancePage"
             BackgroundColor="#0A0A0A"
             Title="Trial Balance">

    <Grid RowDefinitions="Auto, *">

        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <ScrollView Grid.Row="1" Padding="16,10,16,20">
            <VerticalStackLayout Spacing="16">

                <!-- Header Info -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="PageTitleLabel"
                               Text="Trial Balance"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="PageSubtitleLabel"
                               Text="Saldo setiap akun aktif dari Jurnal Umum."
                               FontSize="12"
                               TextColor="#D8D8D8" />
                    </VerticalStackLayout>
                </Grid>

                <ActivityIndicator x:Name="LoadingIndicator"
                                   Color="#FFFFFF"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HeightRequest="40" />

                <!-- Empty State -->
                <VerticalStackLayout x:Name="EmptyStateContainer"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40"
                                     IsVisible="False">
                    <Label Text="&#xeaa2;" FontFamily="TablerIcons" FontSize="44" TextColor="#D8D8D8" HorizontalOptions="Center" />
                    <Label x:Name="EmptyStateLabel"
                           Text="Tidak ada periode yang dipilih."
                           TextColor="#D8D8D8"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Status Balance Alert -->
                <Border x:Name="BalanceStatusCard"
                        IsVisible="False"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label x:Name="BalanceStatusIcon" Text="&#xea67;" FontFamily="TablerIcons" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label x:Name="BalanceStatusText" Text="Debit dan Kredit seimbang." FontSize="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Table Header / Footer & Data List -->
                <Border x:Name="TableContainer"
                        IsVisible="False"
                        BackgroundColor="#141014"
                        Stroke="#1E121F"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout>
                        
                        <!-- Header Kolom -->
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" Padding="12,10" BackgroundColor="#0A0A0A">
                            <Label Grid.Column="0" Text="Ref" TextColor="#D8D8D8" FontSize="11" FontAttributes="Bold" WidthRequest="40" />
                            <Label Grid.Column="1" Text="Akun" TextColor="#D8D8D8" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="Debit" TextColor="#D8D8D8" FontSize="11" FontAttributes="Bold" WidthRequest="85" HorizontalTextAlignment="End" />
                            <Label Grid.Column="3" Text="Kredit" TextColor="#D8D8D8" FontSize="11" FontAttributes="Bold" WidthRequest="85" HorizontalTextAlignment="End" />
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="#1E121F" />

                        <!-- List Data (ItemSizingStrategy ditambahkan agar lancar di ScrollView) -->
                        <CollectionView x:Name="TrialBalanceCollectionView" 
                                        SelectionMode="None"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" Padding="12,10" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="{Binding ReferenceNumber}" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" WidthRequest="40" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding AccountName}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                                                <Label Text="{Binding Type}" TextColor="#D8D8D8" FontSize="10" />
                                            </VerticalStackLayout>
                                            
                                            <!-- Diperbaiki: Menggunakan StringFormat bawaan XAML -->
                                            <Label Grid.Column="2" 
                                                   Text="{Binding Debit, StringFormat='{0:N0}'}" 
                                                   TextColor="#4FA36A" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" 
                                                   WidthRequest="85" 
                                                   HorizontalTextAlignment="End" 
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="3" 
                                                   Text="{Binding Credit, StringFormat='{0:N0}'}" 
                                                   TextColor="#D7192F" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" 
                                                   WidthRequest="85" 
                                                   HorizontalTextAlignment="End" 
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#1E121F" Opacity="0.5" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Footer Total (Diperbaiki alignment kolomnya agar presisi) -->
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" Padding="12,12" BackgroundColor="#0A0A0A">
                            <Label Grid.Column="0" Grid.ColumnSpan="2" Text="Total" TextColor="White" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            <Label x:Name="TotalDebitLabel" Grid.Column="2" Text="0" TextColor="#4FA36A" FontSize="13" FontAttributes="Bold" WidthRequest="85" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            <Label x:Name="TotalCreditLabel" Grid.Column="3" Text="0" TextColor="#D7192F" FontSize="13" FontAttributes="Bold" WidthRequest="85" HorizontalTextAlignment="End" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
