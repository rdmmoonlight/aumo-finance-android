<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Reports.PostClosingTrialBalance.PostClosingTrialBalancePage"
             BackgroundColor="#0A0A0A"
             Title="Post-Closing Trial Balance">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Bar Navigasi Kustom -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <ScrollView Grid.Row="1" Padding="16,10,16,20">
            <VerticalStackLayout Spacing="16">

                <!-- Page Header -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Post-Closing Trial Balance"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="SubtitleLabel"
                               Text="Menampilkan akun permanen setelah closing entries."
                               FontSize="12"
                               TextColor="#D8D8D8" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Loading Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   Color="#FFFFFF"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HeightRequest="40" />

                <!-- Empty State -->
                <VerticalStackLayout x:Name="EmptyStateContainer"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40"
                                     IsVisible="False">
                    <Label Text="&#xed58;" FontFamily="TablerIcons" FontSize="44" TextColor="#D8D8D8" HorizontalOptions="Center" />
                    <Label x:Name="EmptyStateLabel"
                           Text="Tidak ada data post-closing trial balance pada periode ini."
                           TextColor="#D8D8D8"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Table Container -->
                <Border x:Name="TableContainer"
                        IsVisible="False"
                        BackgroundColor="#141014"
                        Stroke="#1E121F"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout>

                        <!-- Header Kolom -->
                        <Grid ColumnDefinitions="50, *, 90, 90, 90" ColumnSpacing="4" Padding="12,10" BackgroundColor="#0A0A0A">
                            <Label Grid.Column="0" Text="Ref" TextColor="#D8D8D8" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Account Name" TextColor="#D8D8D8" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="Type" TextColor="#D8D8D8" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="Debit" TextColor="#D8D8D8" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Grid.Column="4" Text="Credit" TextColor="#D8D8D8" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#1E121F" />

                        <!-- CollectionView Data (Assets, Liabilities, Equity, Retained Earnings) -->
                        <CollectionView x:Name="TrialBalanceCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="50, *, 90, 90, 90" ColumnSpacing="4" Padding="12,10" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="{Binding ReferenceNumber}" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding AccountName}" TextColor="White" FontSize="12" VerticalOptions="Center" />
                                            <Border Grid.Column="2" BackgroundColor="#1E121F" StrokeShape="RoundRectangle 4" Padding="4,2" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label Text="{Binding TypeLabel}" TextColor="#D8D8D8" FontSize="10" />
                                            </Border>
                                            <Label Grid.Column="3" Text="{Binding FormattedDebit}" TextColor="#4FA36A" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                            <Label Grid.Column="4" Text="{Binding FormattedCredit}" TextColor="#D7192F" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#1E121F" Opacity="0.4" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Footer Totals -->
                        <Grid ColumnDefinitions="*, 90, 90" ColumnSpacing="4" Padding="12,12" BackgroundColor="#0A0A0A">
                            <Label Grid.Column="0" Text="Total" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            <Label x:Name="TotalDebitLabel" Grid.Column="1" Text="Rp 0" TextColor="#4FA36A" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            <Label x:Name="TotalCreditLabel" Grid.Column="2" Text="Rp 0" TextColor="#D7192F" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Balance Status Alert Card -->
                <Border x:Name="BalanceStatusCard"
                        IsVisible="False"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label x:Name="BalanceStatusIcon" Text="&#xea67;" FontFamily="TablerIcons" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                        <Label x:Name="BalanceStatusText" Text="Post-closing trial balance seimbang." FontSize="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
