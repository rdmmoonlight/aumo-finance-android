<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textPeriodName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum ada periode dipilih"
            android:textColor="#9C8FA6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textPeriodClosedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Periode Ditutup"
            android:textColor="@color/colorBad"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Ringkasan Neraca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/colorSurface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Aset"
                android:textColor="#9C8FA6"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/textTotalAssets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Total Liabilitas"
                android:textColor="#9C8FA6"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/textTotalLiabilities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Total Ekuitas"
                android:textColor="#9C8FA6"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/textTotalEquity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Ringkasan Laba Rugi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/colorSurfaceElevated"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laba Bersih Periode Ini"
                android:textColor="#9C8FA6"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/textNetIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="@color/colorGood"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRevenueExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pendapatan Rp 0  •  Beban Rp 0"
                android:textColor="#9C8FA6"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Kas & Bank -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Kas"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCashAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />
        <TextView
            android:id="@+id/textTotalCash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Total Kas: Rp 0"
            android:textColor="#9C8FA6"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bank"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBankAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />
        <TextView
            android:id="@+id/textTotalBank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Total Bank: Rp 0"
            android:textColor="#9C8FA6"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
