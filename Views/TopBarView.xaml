<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Views.TopBarView"
             BackgroundColor="#0F172A">

    <Grid ColumnDefinitions="Auto, *, Auto"
          VerticalOptions="Center"
          Padding="4,12,16,12">

        <!-- SISI KIRI: Tombol Menu Navigasi + Periode -->
        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
            
            <!-- Tombol Menu (Trigger AppShell Drawer) -->
            <Button x:Name="MenuButton"
                    Text="☰"
                    FontSize="20"
                    TextColor="#94A3B8"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    Padding="0"
                    HeightRequest="36"
                    WidthRequest="36"
                    Clicked="OnMenuButtonClicked" />

            <!-- Label Periode -->
            <Label x:Name="PeriodLabel"
                   Text="-"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#94A3B8"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- SISI KANAN: Indikator Connectivity & Queue Data -->
        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
            
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="10,4">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    
                    <!-- Bulatan Indikator Status Koneksi -->
                    <Ellipse x:Name="ConnectionStatusDot"
                             WidthRequest="8"
                             HeightRequest="8"
                             Fill="#10B981"
                             VerticalOptions="Center" />

                    <!-- Label Status Queue & Online/Offline -->
                    <Label x:Name="NetworkQueueLabel"
                           Text="Online"
                           FontSize="11"
                           TextColor="#CBD5E1"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                </HorizontalStackLayout>
            </Border>

        </HorizontalStackLayout>

    </Grid>

</ContentView>
