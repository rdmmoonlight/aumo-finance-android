<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Views.TopBarView"
             BackgroundColor="#0F172A">

    <Grid ColumnDefinitions="Auto, *, Auto"
          VerticalOptions="Center"
          Padding="20,12,20,12">

        <!-- SISI KIRI: Tombol Menu Navigasi + Periode -->
        <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
            
            <!-- Tombol Menu dengan Flyout resmi MAUI -->
            <Button x:Name="MenuButton"
                    Text="☰"
                    FontSize="20"
                    TextColor="#94A3B8"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    Padding="0"
                    HeightRequest="36"
                    WidthRequest="36">
                <Button.Flyout>
                    <MenuFlyout x:Name="TopMenuFlyout">
                        <MenuFlyoutSubItem Text="Report">
                            <MenuFlyoutItem Text="General Journal" Clicked="OnGeneralJournalClicked" />
                            <MenuFlyoutItem Text="GL (Akun Permanen)" Clicked="OnGlPermanentClicked" />
                            <MenuFlyoutItem Text="GL (Akun Sementara)" Clicked="OnGlTemporaryClicked" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="COA" Clicked="OnCoaClicked" />
                        <MenuFlyoutItem Text="Periode" Clicked="OnPeriodClicked" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Label Periode -->
            <Label x:Name="PeriodLabel"
                   Text="-"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#94A3B8"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- SISI KANAN: Tag Versi -->
        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="8,4">
                <Label Text="v1.0"
                       FontSize="11"
                       TextColor="#64748B"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Border>
        </HorizontalStackLayout>

    </Grid>

</ContentView>
