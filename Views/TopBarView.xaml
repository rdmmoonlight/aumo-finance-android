<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Views.TopBarView">

    <Grid ColumnDefinitions="*, 120" 
          Padding="20,14" 
          BackgroundColor="#0F172A">

        <!-- Periode -->
        <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
            <Label Text="📅" FontSize="11" VerticalOptions="Center" />
            <Label x:Name="PeriodLabel"
                   Text="Periode: -"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="#94A3B8"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Indikator Sync DB (Queue / Uploading) -->
        <Border Grid.Column="1"
                x:Name="SyncBadge"
                HorizontalOptions="End"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="#1E293B"
                Stroke="#334155"
                StrokeThickness="1"
                Padding="10,5"
                VerticalOptions="Center">

            <Label x:Name="SyncLabel"
                   Text="Siap"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>
    </Grid>

</ContentView>
