<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Views.TopBarView">

    <Grid ColumnDefinitions="*, 120" 
          Padding="20,14" 
          BackgroundColor="#0F172A">

        <!-- Periode -->
        <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
        <Label x:Name="PeriodLabel"
           Text="-"
           FontSize="18"
           FontAttributes="Bold"
           TextColor="#94A3B8"
           VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Indikator Sync DB (Queue / Uploading) — hanya warna, tanpa teks -->
        <Border Grid.Column="1"
                x:Name="SyncBadge"
                HorizontalOptions="End"
                WidthRequest="14"
                HeightRequest="14"
                StrokeShape="RoundRectangle 7"
                BackgroundColor="#10B981"
                Stroke="#10B981"
                StrokeThickness="1"
                Padding="0"
                VerticalOptions="Center" />
    </Grid>

</ContentView>
