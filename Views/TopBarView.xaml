<!-- Container Header TopBar -->
<Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" Padding="16,10">

    <!-- SISI KIRI: Tombol Menu Navigasi & Periode -->
    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
        
        <!-- Tombol Menu (Flyout Dropdown) -->
        <ImageButton Text="☰"
                     FontSize="20"
                     TextColor="#94A3B8"
                     BackgroundColor="Transparent"
                     VerticalOptions="Center"
                     Padding="4">
            <FlyoutBase.AttachedFlyout>
                <MenuFlyout>
                    <!-- 1. Report Submenu -->
                    <MenuFlyoutSubItem Text="Report">
                        <MenuFlyoutItem Text="General Journal" Clicked="OnGeneralJournalClicked" />
                        <MenuFlyoutItem Text="GL (Akun Permanen)" Clicked="OnGlPermanentClicked" />
                        <MenuFlyoutItem Text="GL (Akun Sementara)" Clicked="OnGlTemporaryClicked" />
                    </MenuFlyoutSubItem>

                    <!-- 2. COA -->
                    <MenuFlyoutItem Text="COA" Clicked="OnCoaClicked" />

                    <!-- 3. Periode -->
                    <MenuFlyoutItem Text="Periode" Clicked="OnPeriodClicked" />
                </MenuFlyout>
            </FlyoutBase.AttachedFlyout>
        </ImageButton>

        <!-- Label Periode (Di sebelah kanan ikon menu) -->
        <Label x:Name="PeriodLabel"
               Text="-"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#94A3B8"
               VerticalOptions="Center" />
    </HorizontalStackLayout>

    <!-- Sisi kanan (jika ada elemen lain seperti Sync Status/Version Tag) tetap berada di Column="2" -->

</Grid>
