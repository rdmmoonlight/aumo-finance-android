<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Views.TopBarView"
             BackgroundColor="#0F172A">

    <!-- Padding kiri dikurangi menjadi 4 agar tombol menepi ke kiri layar -->
    <Grid ColumnDefinitions="Auto, *, Auto"
          VerticalOptions="Center"
          Padding="4,12,16,12">

        <!-- SISI KIRI: Tombol Menu Navigasi + Periode -->
        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
            
            <!-- Tombol Menu dengan ContextFlyout -->
            <Button x:Name="MenuButton"
                    Text="☰"
                    FontSize="20"
                    TextColor="#94A3B8"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    Padding="0"
                    HeightRequest="36"
                    WidthRequest="36"
                    Clicked="OnMenuButtonClicked">
                <FlyoutBase.ContextFlyout>
                    <MenuFlyout x:Name="TopMenuFlyout">
                        <MenuFlyoutSubItem Text="Reports &amp; Journals">
                            <MenuFlyoutItem Text="General Journal" Clicked="OnGeneralJournalClicked" />
                            <MenuFlyoutItem Text="Adjusting Journal" Clicked="OnAdjustingJournalClicked" />
                            <MenuFlyoutItem Text="General Ledger (Permanent)" Clicked="OnGlPermanentClicked" />
                            <MenuFlyoutItem Text="General Ledger (Temporary)" Clicked="OnGlTemporaryClicked" />
                            <MenuFlyoutItem Text="Trial Balance" Clicked="OnTrialBalanceClicked" />
                            <MenuFlyoutItem Text="Adjusted Trial Balance" Clicked="OnAdjustedTrialBalanceClicked" />
                            <MenuFlyoutItem Text="Worksheet (10-Column)" Clicked="OnWorksheetClicked" />
                            <MenuFlyoutItem Text="Income Statement" Clicked="OnIncomeStatementClicked" />
                            <MenuFlyoutItem Text="Retained Earnings Statement" Clicked="OnRetainedEarningsClicked" />
                            <MenuFlyoutItem Text="Statement of Financial Position" Clicked="OnSofpClicked" />
                            <MenuFlyoutItem Text="Post-Closing Trial Balance" Clicked="OnPostClosingClicked" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="Chart of Accounts (COA)" Clicked="OnCoaClicked" />
                        <MenuFlyoutItem Text="Accounting Periods" Clicked="OnPeriodClicked" />
                    </MenuFlyout>
                </FlyoutBase.ContextFlyout>
            </Button>

            <!-- Label Periode -->
            <Label x:Name="PeriodLabel"
                   Text="-"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#94A3B8"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- SISI KANAN: Tag Versi -->
        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="8,4">
                <Label Text="v1.0"
                       FontSize="11"
                       TextColor="#64748B"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Border>
        </HorizontalStackLayout>

    </Grid>

</ContentView>
