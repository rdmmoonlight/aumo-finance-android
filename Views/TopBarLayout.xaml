<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:views="clr-namespace:AumoFinance.Views"
  x:Class="AumoFinance.Views.TopBarLayout"
  x:Name="Root">

  <Grid RowDefinitions="Auto,*">
    <!-- Persistent top bar -->
    <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

    <!-- Area halaman spesifik akan ditaruh di sini -->
    <ContentPresenter Grid.Row="1"
                      Content="{Binding Content, Source={x:Reference Root}}" />
  </Grid>
</ContentView>
