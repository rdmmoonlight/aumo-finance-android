<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.MainPage"
             BackgroundColor="#0F172A">

    <!-- Gunakan Grid untuk menumpuk Konten Utama dan Floating Action Buttons di atasnya -->
    <Grid>

        <Grid RowDefinitions="Auto, *">

            <!-- Top Bar Component (Header, Menu Dropdown, & Versi Tag) -->
            <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

            <!-- Indikator Loading (tampil saat data dashboard sedang diambil) -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               Grid.Row="1"
                               Color="#4F46E5"
                               IsRunning="False"
                               IsVisible="False"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <!-- Area Konten Utama Dashboard -->
            <!-- Padding bawah dilebihkan (90) agar konten tidak tertutup tombol FAB mengapung -->
            <ScrollView x:Name="DashboardContent" Grid.Row="1" Padding="20,10,20,90">
                <VerticalStackLayout Spacing="20">

                    <!-- Card Utama: Kas Saat Ini (Hero Card) -->
                    <Border StrokeShape="RoundRectangle 20"
                            StrokeThickness="0"
                            Padding="20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0.0" />
                                <GradientStop Color="#7C3AED" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#4F46E5" Offset="0,8" Radius="15" Opacity="0.3" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="Saldo Kas Dan Bank"
                                       TextColor="#E0E7FF"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1" />
                            </HorizontalStackLayout>
                            <Label x:Name="CashLabel"
                                   Text="Rp 0"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card Laba Bersih -->
                    <Border BackgroundColor="#1E293B"
                            Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="18">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Laba Bersih"
                                       TextColor="#94A3B8"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8" />
                                <Label x:Name="NetIncomeLabel"
                                       Text="Rp 0"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#4ADE80" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Grid Pendapatan & Beban -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        
                        <!-- Card Pendapatan -->
                        <Border Grid.Column="0"
                                BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="14">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="Pendapatan"
                                           TextColor="#94A3B8"
                                           FontSize="10"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label x:Name="RevenueLabel"
                                       Text="Rp 0"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#38BDF8" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card Pengeluaran / Beban -->
                        <Border Grid.Column="1"
                                BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="14">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="Pengeluaran"
                                           TextColor="#94A3B8"
                                           FontSize="10"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label x:Name="ExpenseLabel"
                                       Text="Rp 0"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#F87171" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Action Buttons -->
                    <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                        
                        <!-- Primary CTA Button -->
                        <Button Text="Input Jurnal Baru"
                                Clicked="OnInputJournalClicked"
                                BackgroundColor="#10B981"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="15"
                                CornerRadius="14"
                                HeightRequest="52">
                            <Button.Shadow>
                                <Shadow Brush="#10B981" Offset="0,4" Radius="8" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>

                        <!-- Secondary Button -->
                        <Button Text="Muat Ulang Data"
                                Clicked="OnRefreshClicked"
                                BackgroundColor="#1E293B"
                                BorderColor="#334155"
                                BorderWidth="1"
                                TextColor="#94A3B8"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="14"
                                HeightRequest="48" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- FLOATING ACTION BUTTONS (FAB) DI POJOK KANAN BAWAH -->
        <VerticalStackLayout VerticalOptions="End" 
                             HorizontalOptions="End" 
                             Margin="0,0,20,24" 
                             Spacing="10"
                             ZIndex="999">

            <!-- Tombol Kedua (Placeholder / Ide Bebas Anda) -->
            <Button Text="⚙️ Opsi"
                    BackgroundColor="#334155"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="12"
                    CornerRadius="20"
                    HeightRequest="40"
                    Padding="16,0"
                    Clicked="OnSecondaryFabClicked">
                <Button.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.3" />
                </Button.Shadow>
            </Button>

            <!-- Tombol Pertama (Utama: Input Jurnal Cepat) -->
            <Button Text="➕ Jurnal"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="24"
                    HeightRequest="48"
                    Padding="18,0"
                    Clicked="OnPrimaryFabClicked">
                <Button.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.4" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
