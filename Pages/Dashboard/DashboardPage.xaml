<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Dashboard.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Bar Component -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <!-- Main Dashboard Content Scrollable Area -->
        <ScrollView Grid.Row="1" Padding="20,20,20,40">
            <VerticalStackLayout Spacing="20">

                <!-- Accounting Period Banner Header -->
                <Border BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16,12">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="ACCOUNTING PERIOD"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#94A3B8"
                                   CharacterSpacing="0.8" />
                            <Label x:Name="PeriodText"
                                   Text="Loading Period..."
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </VerticalStackLayout>

                        <ImageButton Grid.Column="1"
                                     Source="icon_refresh.png"
                                     HeightRequest="24"
                                     WidthRequest="24"
                                     VerticalOptions="Center"
                                     Clicked="OnRefreshClicked"
                                     ToolTipProperties.Text="Refresh Data" />
                    </Grid>
                </Border>

                <!-- Loading Indicator Overlay -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HeightRequest="40"
                                   WidthRequest="40"
                                   Color="#38BDF8"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0" />

                <!-- Dashboard Metrics Content -->
                <VerticalStackLayout x:Name="DashboardContent"
                                     Spacing="16"
                                     IsVisible="False">

                    <!-- Main Balance Card (Total Cash / Assets) -->
                    <Border BackgroundColor="#1E293B"
                            Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Total Cash &amp; Assets"
                                   FontSize="13"
                                   TextColor="#94A3B8" />
                            <Label x:Name="CashLabel"
                                   Text="Rp 0"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="#38BDF8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Financial Summary Grid (2 Columns x 2 Rows) -->
                    <Grid ColumnDefinitions="*, *"
                          RowDefinitions="Auto, Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">

                        <!-- Net Income Card -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Grid.ColumnSpan="2"
                                BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="16">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Net Income"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#94A3B8"
                                       CharacterSpacing="0.8" />
                                <Label x:Name="NetIncomeLabel"
                                       Text="Rp 0"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Revenue Card -->
                        <Border Grid.Row="1" Grid.Column="0"
                                BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="16">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Revenue"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#94A3B8"
                                       CharacterSpacing="0.8" />
                                <Label x:Name="RevenueLabel"
                                       Text="Rp 0"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#4ADE80" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Expenses Card -->
                        <Border Grid.Row="1" Grid.Column="1"
                                BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="16">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Expenses"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#94A3B8"
                                       CharacterSpacing="0.8" />
                                <Label x:Name="ExpenseLabel"
                                       Text="Rp 0"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#F87171" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <!-- Application Settings Section -->
                    <Border BackgroundColor="#1E293B"
                            Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="SETTINGS &amp; UPDATES"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#94A3B8"
                                   CharacterSpacing="0.8" />

                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Automatic Updates"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label Text="Automatically check for app updates on startup"
                                           FontSize="10"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Switch x:Name="AutoUpdateSwitch"
                                        Grid.Column="1"
                                        OnColor="#4F46E5"
                                        ThumbColor="White"
                                        Toggled="OnAutoUpdateToggled" />
                            </Grid>

                            <Button Text="Check for Updates"
                                    BackgroundColor="#334155"
                                    TextColor="#38BDF8"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="10"
                                    HeightRequest="40"
                                    Clicked="OnCheckUpdateManualClicked" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Primary Action Floating Button -->
        <ImageButton Grid.Row="1"
                     Source="icon_add.png"
                     BackgroundColor="#2563EB"
                     CornerRadius="28"
                     HeightRequest="56"
                     WidthRequest="56"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     Margin="0,0,24,24"
                     Shadow="{Shadow Brush=Black, Offset='2,4', Radius=8, Opacity=0.3}"
                     Clicked="OnPrimaryFabClicked"
                     ToolTipProperties.Text="New Journal Entry" />

    </Grid>

</ContentPage>
