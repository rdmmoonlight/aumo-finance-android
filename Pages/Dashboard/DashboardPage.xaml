<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Dashboard.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Bar Component -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <!-- Main Dashboard Content Scrollable Area -->
        <RefreshView x:Name="DashboardRefreshView" Grid.Row="1" Refreshing="OnRefreshViewRefreshing">
            <ScrollView Padding="20,20,20,40">
                <VerticalStackLayout Spacing="16">

                    <!-- Page Header -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Dashboard"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Financial summary for the current period."
                                   FontSize="12"
                                   TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Loading Indicator Overlay -->
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="True"
                                       IsVisible="True"
                                       HeightRequest="40"
                                       WidthRequest="40"
                                       Color="#38BDF8"
                                       HorizontalOptions="Center"
                                       Margin="0,20,0,0" />

                    <!-- Dashboard Metrics Content -->
                    <VerticalStackLayout x:Name="DashboardContent"
                                         Spacing="16"
                                         IsVisible="False">

                        <!-- Main Balance Card (Total Cash / Assets) -->
                        <Border BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="20">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Total Cash &amp; Assets"
                                       FontSize="13"
                                       TextColor="#94A3B8" />
                                <Label x:Name="CashLabel"
                                       Text="Rp 0"
                                       FontSize="32"
                                       FontAttributes="Bold"
                                       TextColor="#38BDF8" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Cash on Hand Card -->
                        <Border x:Name="CashCard"
                                BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="16"
                                IsVisible="False">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="CASH ON HAND"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#F59E0B"
                                       CharacterSpacing="0.8" />
                                <BoxView HeightRequest="1" Color="#334155" />
                                <VerticalStackLayout x:Name="CashItemsLayout" Spacing="10" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Bank Balances Card -->
                        <Border x:Name="BankCard"
                                BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="16"
                                IsVisible="False">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="BANK BALANCES"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#F59E0B"
                                       CharacterSpacing="0.8" />
                                <BoxView HeightRequest="1" Color="#334155" />
                                <VerticalStackLayout x:Name="BankItemsLayout" Spacing="10" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Financial Summary Grid (2 Columns x 2 Rows) -->
                        <Grid ColumnDefinitions="*, *"
                              RowDefinitions="Auto, Auto"
                              ColumnSpacing="12"
                              RowSpacing="12">

                            <!-- Net Income Card -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    BackgroundColor="#1E293B"
                                    Stroke="#334155"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Net Income"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#94A3B8"
                                           CharacterSpacing="0.8" />
                                    <Label x:Name="NetIncomeLabel"
                                           Text="Rp 0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Total Revenue Card -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    BackgroundColor="#1E293B"
                                    Stroke="#334155"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Revenue"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#94A3B8"
                                           CharacterSpacing="0.8" />
                                    <Label x:Name="RevenueLabel"
                                           Text="Rp 0"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#4ADE80" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Total Expenses Card -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    BackgroundColor="#1E293B"
                                    Stroke="#334155"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Expenses"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#94A3B8"
                                           CharacterSpacing="0.8" />
                                    <Label x:Name="ExpenseLabel"
                                           Text="Rp 0"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#F87171" />
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Primary Action Floating Button -->
        <Button Grid.Row="1"
                Text="&#xE145;"
                FontFamily="MaterialIcons"
                FontSize="26"
                TextColor="White"
                BackgroundColor="#2563EB"
                CornerRadius="28"
                Padding="0"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,24,24"
                Shadow="{Shadow Brush=Black, Offset='2,4', Radius=8, Opacity=0.3}"
                Clicked="OnPrimaryFabClicked"
                ToolTipProperties.Text="New Journal Entry" />

    </Grid>

</ContentPage>
