<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.Dashboard.DashboardPage"
             Title="Dashboard"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Navigation / Period Banner Header -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#0F172A}"
                Padding="16,12"
                StrokeShape="RoundRectangle 0,0,0,0"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="ACCOUNTING PERIOD"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#94A3B8"
                           CharacterSpacing="1" />
                    <Label x:Name="PeriodText"
                           Text="Loading Period..."
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <ImageButton Grid.Column="1"
                             Source="icon_refresh.png"
                             HeightRequest="24"
                             WidthRequest="24"
                             VerticalOptions="Center"
                             Clicked="OnRefreshClicked"
                             ToolTipProperties.Text="Refresh Data" />
            </Grid>
        </Border>

        <!-- Main Dashboard Content Scrollable Area -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Loading Indicator Overlay -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HeightRequest="40"
                                   WidthRequest="40"
                                   Color="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                                   HorizontalOptions="Center"
                                   Margin="0,32,0,0" />

                <!-- Dashboard Metrics Content -->
                <VerticalStackLayout x:Name="DashboardContent"
                                     Spacing="16"
                                     IsVisible="False">

                    <!-- Main Balance Card (Total Cash / Assets) -->
                    <Border BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#1D4ED8}"
                            Padding="20"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Total Cash &amp; Assets"
                                   FontSize="14"
                                   TextColor="#DBEAFE" />
                            <Label x:Name="CashLabel"
                                   Text="$0.00"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Financial Summary Grid (2 Columns x 2 Rows) -->
                    <Grid ColumnDefinitions="*, *"
                          RowDefinitions="Auto, Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">

                        <!-- Net Income Card -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Grid.ColumnSpan="2"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                Padding="16"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Net Income"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label x:Name="NetIncomeLabel"
                                       Text="$0.00"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Revenue Card -->
                        <Border Grid.Row="1" Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                Padding="16"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Revenue"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label x:Name="RevenueLabel"
                                       Text="$0.00"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#16A34A" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Expenses Card -->
                        <Border Grid.Row="1" Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                Padding="16"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Expenses"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label x:Name="ExpenseLabel"
                                       Text="$0.00"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#DC2626" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <!-- Application Settings Section -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                            Padding="16"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="SETTINGS &amp; UPDATES"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   CharacterSpacing="1" />

                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="Automatic Updates"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                    <Label Text="Automatically check for app updates on startup"
                                           FontSize="11"
                                           TextColor="#94A3B8" />
                                </VerticalStackLayout>
                                <Switch x:Name="AutoUpdateSwitch"
                                        Grid.Column="1"
                                        Toggled="OnAutoUpdateToggled" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#334155}" />

                            <Button Text="Check for Updates"
                                    FontSize="13"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                                    BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    Clicked="OnCheckUpdateManualClicked" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Primary Action Floating Button (Create Journal Entry) -->
        <ImageButton Grid.Row="1"
                     Source="icon_add.png"
                     BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#1D4ED8}"
                     CornerRadius="28"
                     HeightRequest="56"
                     WidthRequest="56"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     Margin="0,0,24,24"
                     Shadow="{Shadow Brush=Black, Offset='2,4', Radius=8, Opacity=0.25}"
                     Clicked="OnPrimaryFabClicked"
                     ToolTipProperties.Text="New Journal Entry" />

    </Grid>

</ContentPage>
