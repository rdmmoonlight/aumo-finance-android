<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.JournalEntry.JournalEntryPage"
             Title="Input Jurnal">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Input Jurnal (Double Entry)"
                   TextColor="#38BDF8"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Tanggal Transaksi -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Tanggal Transaksi"
                       TextColor="#94A3B8"
                       FontSize="14" />
                <Border Stroke="#334155"
                        StrokeThickness="1"
                        Background="#1E293B"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">
                    <DatePicker x:Name="EntryDatePicker"
                                TextColor="White"
                                Format="dd/MM/yyyy"
                                HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Baris Jurnal (ditambahkan secara dinamis dari code-behind) -->
            <VerticalStackLayout x:Name="LinesContainer" Spacing="12" />

            <Button Text="+ Tambah Baris"
                    BackgroundColor="Transparent"
                    TextColor="#38BDF8"
                    BorderColor="#334155"
                    BorderWidth="1"
                    HeightRequest="44"
                    CornerRadius="10"
                    Clicked="OnAddLineClicked" />

            <!-- Ringkasan Total -->
            <Border Stroke="#334155"
                    StrokeThickness="1"
                    Background="#1E293B"
                    StrokeShape="RoundRectangle 10"
                    Padding="14">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0" Text="Total Debit" TextColor="#94A3B8" FontSize="13" />
                    <Label Grid.Row="0" Grid.Column="1" x:Name="TotalDebitLabel" Text="Rp 0" TextColor="White" FontSize="13" HorizontalOptions="End" />
                    <Label Grid.Row="1" Grid.Column="0" Text="Total Kredit" TextColor="#94A3B8" FontSize="13" />
                    <Label Grid.Row="1" Grid.Column="1" x:Name="TotalCreditLabel" Text="Rp 0" TextColor="White" FontSize="13" HorizontalOptions="End" />
                </Grid>
            </Border>

            <Label x:Name="BalanceStatusLabel"
                   Text="Belum Seimbang"
                   TextColor="#F87171"
                   FontSize="13"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Tombol Aksi -->
            <Button x:Name="SaveBtn"
                    Text="SIMPAN JURNAL"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="52"
                    CornerRadius="10"
                    Margin="0,15,0,0"
                    Clicked="OnSaveClicked" />

            <Button Text="Batal"
                    BackgroundColor="Transparent"
                    TextColor="#94A3B8"
                    BorderColor="#334155"
                    BorderWidth="1"
                    HeightRequest="48"
                    CornerRadius="10"
                    Clicked="OnCancelClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
