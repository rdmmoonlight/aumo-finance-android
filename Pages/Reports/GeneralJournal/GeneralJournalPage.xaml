<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Reports.GeneralJournal.GeneralJournalPage"
             BackgroundColor="#0F172A"
             Title="General Journal">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Navigation Bar -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto, *" Padding="16,10,16,0" RowSpacing="16">

            <!-- Page Header & Refresh Button -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="General Journal"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Chronological record of all transactions."
                           FontSize="12"
                           TextColor="#94A3B8" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="🔄 Refresh"
                        Clicked="OnRefreshClicked"
                        BackgroundColor="#F59E0B"
                        TextColor="#0F172A"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="10"
                        Padding="12,0"
                        HeightRequest="40" />
            </Grid>

            <!-- Active Period Indicator -->
            <Border Grid.Row="1"
                    BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="👁️" FontSize="14" VerticalOptions="Center" />
                    <Label Text="Menampilkan Periode:"
                           TextColor="#94A3B8"
                           FontSize="12"
                           VerticalOptions="Center" />
                    <Label x:Name="SelectedPeriodHeaderLabel"
                           Text="Loading Active Period..."
                           TextColor="#F8FAFC"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Loading Indicator -->
            <ActivityIndicator Grid.Row="2"
                               x:Name="LoadingIndicator"
                               Color="#F59E0B"
                               IsRunning="True"
                               IsVisible="True"
                               HeightRequest="40" />

            <!-- Empty state + list share the remaining space. CollectionView provides
                 its own scrolling/virtualization, so it must not be nested inside a ScrollView. -->
            <Grid Grid.Row="3">

                <!-- Empty State View -->
                <VerticalStackLayout x:Name="EmptyStateView"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40"
                                     IsVisible="False">
                    <Label Text="📖" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No Journal Entries Found"
                           TextColor="#94A3B8"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="There are no transaction records in the active period."
                           TextColor="#64748B"
                           FontSize="12"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- RefreshView List -->
                <RefreshView x:Name="JournalRefreshView"
                             BackgroundColor="#0F172A"
                             RefreshColor="#F59E0B"
                             Refreshing="OnRefreshViewRefreshing">
                    <CollectionView x:Name="JournalCollectionView" SelectionMode="None" Margin="0,0,0,20">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#1E293B"
                                        Stroke="#334155"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Margin="0,0,0,10"
                                        Padding="12">
                                    <VerticalStackLayout Spacing="10">

                                        <!-- Entry Header (Date & Reference) -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 6" Padding="6,2">
                                                    <Label Text="{Binding FormattedDate}" TextColor="#F59E0B" FontSize="11" FontAttributes="Bold" />
                                                </Border>
                                                <Label Text="{Binding JournalType}" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Label Grid.Column="1"
                                                   Text="{Binding ReferenceNumber}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#64748B" />
                                        </Grid>

                                        <!-- Divider Line -->
                                        <BoxView HeightRequest="1" Color="#334155" />

                                        <!-- Transaction Lines Header -->
                                        <Grid ColumnDefinitions="2*, 3*, Auto, Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="Ref #" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                                            <Label Grid.Column="1" Text="Account" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                                            <Label Grid.Column="2" Text="Debit" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" HorizontalTextAlignment="End" WidthRequest="70" />
                                            <Label Grid.Column="3" Text="Credit" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" HorizontalTextAlignment="End" WidthRequest="70" />
                                        </Grid>

                                        <!-- Lines Items Repeater -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="2*, 3*, Auto, Auto" ColumnSpacing="8" Margin="0,2">
                                                        <Label Grid.Column="0" Text="{Binding AccountReferenceNumber}" FontSize="11" TextColor="#64748B" />
                                                        <Label Grid.Column="1" Text="{Binding AccountName}" FontSize="11" FontAttributes="Bold" TextColor="#E2E8F0" LineBreakMode="TailTruncation" />
                                                        <Label Grid.Column="2" Text="{Binding FormattedDebit}" FontSize="11" TextColor="#38BDF8" HorizontalTextAlignment="End" WidthRequest="70" />
                                                        <Label Grid.Column="3" Text="{Binding FormattedCredit}" FontSize="11" TextColor="#EF4444" HorizontalTextAlignment="End" WidthRequest="70" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>

        </Grid>

    </Grid>

</ContentPage>
