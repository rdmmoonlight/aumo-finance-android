<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.AdjustingJournalPage"
             BackgroundColor="#0F172A"
             Title="Adjusting Journal">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Bar Navigasi Kustom -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <ScrollView Grid.Row="1" Padding="16,10,16,20">
            <VerticalStackLayout Spacing="16">

                <!-- Page Header & Action Button -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Adjusting Journal"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Jurnal penyesuaian akhir periode (akrual, deferral, depresiasi)."
                               FontSize="12"
                               TextColor="#94A3B8" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="➕  Tambah"
                            Clicked="OnAddAdjustingEntryClicked"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="10"
                            Padding="12,0"
                            HeightRequest="40" />
                </Grid>

                <!-- Indicator Periode Aktif -->
                <Border x:Name="PeriodCard"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="👁️" FontSize="14" VerticalOptions="Center" />
                        <Label Text="Menampilkan Periode:"
                               TextColor="#94A3B8"
                               FontSize="12"
                               VerticalOptions="Center" />
                        <Label x:Name="PeriodNameLabel"
                               Text="-"
                               TextColor="#F8FAFC"
                               FontAttributes="Bold"
                               FontSize="12"
                               VerticalOptions="Center" />
                        <Border x:Name="ClosedBadge"
                                BackgroundColor="#334155"
                                StrokeShape="RoundRectangle 6"
                                Padding="6,2"
                                IsVisible="False"
                                VerticalOptions="Center">
                            <Label Text="🔒 Closed"
                                   TextColor="#CBD5E1"
                                   FontSize="10"
                                   FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>

                <!-- Loading Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   Color="#F59E0B"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HeightRequest="40" />

                <!-- Empty State -->
                <VerticalStackLayout x:Name="EmptyStateContainer"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40"
                                     IsVisible="False">
                    <Label Text="📑"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label x:Name="EmptyStateLabel"
                           Text="Tidak ada adjusting entries pada periode ini."
                           TextColor="#94A3B8"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Daftar Adjusting Journal Entries -->
                <CollectionView x:Name="AdjustingJournalCollectionView"
                                IsVisible="False"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#1E293B"
                                    Stroke="#334155"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Margin="0,0,0,14"
                                    Padding="14">
                                <VerticalStackLayout Spacing="10">

                                    <!-- Tanggal Header Card -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                            <Border BackgroundColor="#F59E0B"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="8,4">
                                                <Label Text="{Binding EntryDate, StringFormat='{0:dd MMM yyyy}'}"
                                                       TextColor="#0F172A"
                                                       FontSize="11"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="✏️"
                                                BackgroundColor="Transparent"
                                                TextColor="#94A3B8"
                                                FontSize="14"
                                                CommandParameter="{Binding Id}"
                                                Clicked="OnEditEntryClicked"
                                                HeightRequest="36"
                                                WidthRequest="36"
                                                Padding="0" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#334155" Margin="0,2" />

                                    <!-- Detail Baris Debet & Kredit -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="10">
                                                    
                                                    <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="2">
                                                        <HorizontalStackLayout Spacing="6">
                                                            <Label Text="    " IsVisible="{Binding IsCredit}" />
                                                            <Label Text="{Binding AccountName}"
                                                                   TextColor="{Binding AccountTextColor}"
                                                                   FontAttributes="Bold"
                                                                   FontSize="13" />
                                                            <Border BackgroundColor="#0F172A"
                                                                    StrokeShape="RoundRectangle 4"
                                                                    Padding="4,1"
                                                                    VerticalOptions="Center">
                                                                <Label Text="{Binding RefNumber}"
                                                                       TextColor="#64748B"
                                                                       FontSize="9"
                                                                       FontAttributes="Bold" />
                                                            </Border>
                                                        </HorizontalStackLayout>
                                                        
                                                        <Label Text="{Binding LineDescription}"
                                                               TextColor="#64748B"
                                                               FontSize="11"
                                                               LineBreakMode="WordWrap"
                                                               IsVisible="{Binding HasDescription}" />
                                                    </VerticalStackLayout>

                                                    <Label Grid.Column="1" Grid.Row="0"
                                                           Text="{Binding FormattedAmount}"
                                                           TextColor="{Binding AmountColor}"
                                                           FontAttributes="Bold"
                                                           FontSize="13"
                                                           HorizontalOptions="End"
                                                           VerticalOptions="Start" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
