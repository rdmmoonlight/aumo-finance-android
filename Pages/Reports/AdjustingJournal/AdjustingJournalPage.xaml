<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Reports.AdjustingJournal.AdjustingJournalPage"
             BackgroundColor="#0F172A"
             Title="Adjusting Journal">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Navigation Bar -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *" Padding="16,10,16,0" RowSpacing="16">

            <!-- Page Header & Tambah Button -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="8" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Adjusting Journal"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Jurnal penyesuaian akhir periode (akrual, deferral, depresiasi)."
                           FontSize="12"
                           TextColor="#94A3B8" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="➕ Tambah"
                        Clicked="OnAddAdjustingEntryClicked"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="10"
                        Padding="12,0"
                        HeightRequest="40" />
            </Grid>

            <!-- Loading Indicator -->
            <ActivityIndicator Grid.Row="1"
                               x:Name="LoadingIndicator"
                               Color="#F59E0B"
                               IsRunning="True"
                               IsVisible="True"
                               HeightRequest="40" />

            <!-- Empty state + list share the remaining space -->
            <Grid Grid.Row="2">

                <!-- Empty State View -->
                <VerticalStackLayout x:Name="EmptyStateContainer"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40"
                                     IsVisible="False">
                    <Label Text="📑" FontSize="48" HorizontalOptions="Center" />
                    <Label x:Name="EmptyStateLabel"
                           Text="Tidak ada adjusting entries pada periode ini."
                           TextColor="#94A3B8"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- RefreshView List -->
                <RefreshView x:Name="AdjustingJournalRefreshView"
                             BackgroundColor="#0F172A"
                             RefreshColor="#F59E0B"
                             Refreshing="OnRefreshViewRefreshing">
                    <CollectionView x:Name="AdjustingJournalCollectionView" IsGrouped="True" SelectionMode="None" Margin="0,0,0,20">
                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#0F172A"
                                        Stroke="#F59E0B"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,5"
                                        Margin="0,12,0,6">
                                    <Label Text="{Binding GroupHeader}"
                                           TextColor="#F59E0B"
                                           FontAttributes="Bold"
                                           FontSize="13" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#1E293B"
                                        Stroke="#334155"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Margin="0,0,0,10"
                                        Padding="12">
                                    <VerticalStackLayout Spacing="10">

                                        <!-- Entry Header (Nomor Transaksi + Edit/Delete) -->
                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6" VerticalOptions="Center">

                                            <Label Grid.Column="0"
                                                   Text="{Binding TransactionNumber}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#94A3B8"
                                                   VerticalOptions="Center" />

                                            <!-- Edit Entry (pencil) -->
                                            <Button Grid.Column="1"
                                                    Text="✏️"
                                                    FontSize="13"
                                                    WidthRequest="30"
                                                    HeightRequest="30"
                                                    Padding="0"
                                                    CornerRadius="8"
                                                    BackgroundColor="#334155"
                                                    CommandParameter="{Binding Id}"
                                                    Clicked="OnEditEntryClicked" />

                                            <!-- Delete Entry (trash) -->
                                            <Button Grid.Column="2"
                                                    Text="🗑️"
                                                    FontSize="13"
                                                    WidthRequest="30"
                                                    HeightRequest="30"
                                                    Padding="0"
                                                    CornerRadius="8"
                                                    BackgroundColor="#7F1D1D"
                                                    Clicked="OnDeleteEntryClicked" />
                                        </Grid>

                                        <!-- Divider Line -->
                                        <BoxView HeightRequest="1" Color="#334155" />

                                        <!-- Transaction Lines Header -->
                                        <Grid ColumnDefinitions="1.5*, 3*, Auto, Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="Ref #" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                                            <Label Grid.Column="1" Text="Account" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                                            <Label Grid.Column="2" Text="Debit" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" HorizontalTextAlignment="End" WidthRequest="95" />
                                            <Label Grid.Column="3" Text="Credit" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" HorizontalTextAlignment="End" WidthRequest="95" />
                                        </Grid>

                                        <!-- Lines Items Repeater -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="1.5*, 3*, Auto, Auto" ColumnSpacing="8" Margin="0,2">
                                                        <Label Grid.Column="0" Text="{Binding RefNumber}" FontSize="11" TextColor="#64748B" VerticalOptions="Center" />

                                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                            <HorizontalStackLayout Spacing="0">
                                                                <BoxView WidthRequest="18" Color="Transparent" IsVisible="{Binding IsCredit}" />
                                                                <Label Text="{Binding AccountName}" FontSize="11" FontAttributes="Bold" TextColor="#E2E8F0" LineBreakMode="TailTruncation" />
                                                            </HorizontalStackLayout>
                                                            <Label Text="{Binding LineDescriptionDisplay}"
                                                                   FontSize="9"
                                                                   TextColor="#64748B"
                                                                   LineBreakMode="TailTruncation"
                                                                   IsVisible="{Binding HasDescription}" />
                                                        </VerticalStackLayout>

                                                        <Label Grid.Column="2" Text="{Binding FormattedDebit}" FontSize="11" TextColor="#38BDF8" HorizontalTextAlignment="End" WidthRequest="95" VerticalOptions="Center" />
                                                        <Label Grid.Column="3" Text="{Binding FormattedCredit}" FontSize="11" TextColor="#EF4444" HorizontalTextAlignment="End" WidthRequest="95" VerticalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>

        </Grid>

    </Grid>

</ContentPage>
