<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Reports.RetainedEarnings.RetainedEarningsPage"
             BackgroundColor="#0F172A"
             Title="Retained Earnings Statement">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Bar Navigasi Kustom -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <ScrollView Grid.Row="1" Padding="16,10,16,20">
            <VerticalStackLayout Spacing="16">

                <!-- Page Header -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Retained Earnings Statement"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Bridges the Income Statement and Balance Sheet (US GAAP / ASC 210)."
                               FontSize="12"
                               TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Loading Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   Color="#38BDF8"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HeightRequest="40" />

                <!-- Empty State -->
                <VerticalStackLayout x:Name="EmptyStateContainer"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40"
                                     IsVisible="False">
                    <Label Text="🐖" FontSize="48" HorizontalOptions="Center" />
                    <Label x:Name="EmptyStateLabel"
                           Text="Tidak ada data retained earnings pada periode ini."
                           TextColor="#94A3B8"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Card Retained Earnings Statement -->
                <Border x:Name="StatementContainer"
                        IsVisible="False"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16"
                        MaximumWidthRequest="560"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="12">

                        <Label x:Name="AccountNameTitleLabel"
                               Text="Retained Earnings"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <BoxView HeightRequest="1" Color="#334155" />

                        <!-- Baris 1: Beginning Balance -->
                        <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                            <Label x:Name="BeginningLabel" Grid.Column="0" Text="Retained earnings, awal" TextColor="#CBD5E1" FontSize="13" />
                            <Label x:Name="BeginningBalanceLabel" Grid.Column="1" Text="Rp 0" TextColor="White" FontSize="13" HorizontalOptions="End" />
                        </Grid>

                        <!-- Baris 2: Net Income -->
                        <Grid ColumnDefinitions="*, Auto" Padding="12,4,0,4">
                            <Label Grid.Column="0" Text="Add: Net Income for the Period" TextColor="#CBD5E1" FontSize="13" />
                            <Label x:Name="NetIncomeLabel" Grid.Column="1" Text="Rp 0" FontSize="13" HorizontalOptions="End" />
                        </Grid>

                        <!-- Baris 3: Dividends (Conditional) -->
                        <Grid x:Name="DividendsRowContainer" ColumnDefinitions="*, Auto" Padding="12,4,0,4" IsVisible="False">
                            <Label Grid.Column="0" Text="Less: Dividends / Withdrawals" TextColor="#CBD5E1" FontSize="13" />
                            <Label x:Name="DividendsLabel" Grid.Column="1" Text="(Rp 0)" TextColor="#F87171" FontSize="13" HorizontalOptions="End" />
                        </Grid>

                        <BoxView HeightRequest="2" Color="#475569" Margin="0,4" />

                        <!-- Baris 4: Ending Balance -->
                        <Grid ColumnDefinitions="*, Auto" Padding="0,6">
                            <Label x:Name="EndingLabel" Grid.Column="0" Text="Retained earnings, akhir" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label x:Name="EndingBalanceLabel" Grid.Column="1" Text="Rp 0" TextColor="#4ADE80" FontSize="15" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
