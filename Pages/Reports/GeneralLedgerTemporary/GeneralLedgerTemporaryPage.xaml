<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Reports.GeneralLedgerTemporary.GeneralLedgerTemporaryPage"
             BackgroundColor="#0A0A0A"
             Title="General Ledger - Sementara">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Bar Navigasi Kustom -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <ScrollView Grid.Row="1" Padding="16,10,16,20">
            <VerticalStackLayout Spacing="16">

                <!-- Header Halaman & Tombol Navigasi -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="General Ledger"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Akun Nominal (Sementara) — Pendapatan &amp; Beban"
                               FontSize="12"
                               TextColor="#D8D8D8" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="  Jurnal Umum"
                            Clicked="OnGeneralJournalClicked"
                            BackgroundColor="#141014"
                            BorderColor="#1E121F"
                            BorderWidth="1"
                            TextColor="#D8D8D8"
                            FontAttributes="Bold"
                            FontSize="12"
                            CornerRadius="10"
                            Padding="12,0"
                            HeightRequest="40">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="TablerIcons" Glyph="&#xea39;" Color="#D8D8D8" Size="14" />
                        </Button.ImageSource>
                    </Button>
                </Grid>

                <!-- Ringkasan Laba/Rugi Sebelum Penutupan (Net Income Card) -->
                <Border x:Name="NetIncomeCard"
                        BackgroundColor="#141014"
                        Stroke="#1E121F"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,12"
                        IsVisible="False">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="Laba / (Rugi) Bersih Sebelum Penutupan"
                               TextColor="#FFFFFF"
                               FontAttributes="Bold"
                               FontSize="12"
                               VerticalOptions="Center" />
                        <Label x:Name="NetTotalLabel"
                               Grid.Column="1"
                               Text="Rp 0"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#4FA36A"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Indicator Loading -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   Color="#4FA36A"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HeightRequest="40" />

                <!-- Empty State -->
                <VerticalStackLayout x:Name="EmptyStateContainer"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40"
                                     IsVisible="False">
                    <Label Text="&#xeb80;"
                           FontFamily="TablerIcons"
                           FontSize="44"
                           TextColor="#D8D8D8"
                           HorizontalOptions="Center" />
                    <Label Text="Tidak ada akun sementara ditemukan pada periode ini."
                           TextColor="#D8D8D8"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- List Akun Sementara (CollectionView Grouped Card) -->
                <CollectionView x:Name="LedgersCollectionView"
                                IsVisible="False"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#141014"
                                    Stroke="#1E121F"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Margin="0,0,0,16"
                                    Padding="16">
                                <VerticalStackLayout Spacing="12">

                                    <!-- Header Card Akun -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                            <Border BackgroundColor="#0A0A0A"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="6,2">
                                                <Label Text="{Binding ReferenceNumber}"
                                                       TextColor="#FFFFFF"
                                                       FontAttributes="Bold"
                                                       FontSize="12" />
                                            </Border>
                                            <Label Text="{Binding AccountName}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   VerticalOptions="Center" />
                                            <Border BackgroundColor="#1E121F"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="6,2"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Type}"
                                                       TextColor="#D8D8D8"
                                                       FontSize="10" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <!-- Total Saldo Akhir Akun -->
                                        <Label Grid.Column="1"
                                               Text="{Binding FormattedEndingBalance}"
                                               TextColor="{Binding EndingBalanceColor}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#1E121F" />

                                    <!-- Daftar Transaksi/Posting Akun -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" RowDefinitions="Auto, Auto">
                                                    
                                                    <!-- Tanggal & Deskripsi -->
                                                    <Label Grid.Column="0" Grid.Row="0"
                                                           Text="{Binding EntryDate, StringFormat='{0:dd/MM/yy}'}"
                                                           TextColor="#D8D8D8"
                                                           FontSize="11"
                                                           FontAttributes="Bold" />
                                                    
                                                    <Label Grid.Column="1" Grid.Row="0"
                                                           Text="{Binding Description}"
                                                           TextColor="#D8D8D8"
                                                           FontSize="12"
                                                           LineBreakMode="TailTruncation" />

                                                    <!-- Saldo Running -->
                                                    <Label Grid.Column="2" Grid.Row="0"
                                                           Text="{Binding FormattedRunningBalance}"
                                                           TextColor="White"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           HorizontalOptions="End" />

                                                    <!-- Detail Debet & Kredit -->
                                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="10">
                                                        <Label Text="{Binding FormattedDebit}"
                                                               TextColor="#4FA36A"
                                                               FontSize="10"
                                                               IsVisible="{Binding HasDebit}" />
                                                        <Label Text="{Binding FormattedCredit}"
                                                               TextColor="#D7192F"
                                                               FontSize="10"
                                                               IsVisible="{Binding HasCredit}" />
                                                    </HorizontalStackLayout>

                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
