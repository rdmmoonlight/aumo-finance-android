<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.StatementOfFinancialPositionPage"
             BackgroundColor="#0F172A"
             Title="Statement of Financial Position">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Bar Navigasi Kustom -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <ScrollView Grid.Row="1" Padding="16,10,16,20">
            <VerticalStackLayout Spacing="16">

                <!-- Page Header -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Statement of Financial Position"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="SubtitleLabel"
                               Text="Balance Sheet (IAS 1)"
                               FontSize="12"
                               TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Indicator Periode Aktif -->
                <Border x:Name="PeriodCard"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="👁️" FontSize="14" VerticalOptions="Center" />
                        <Label Text="Menampilkan Periode:"
                               TextColor="#94A3B8"
                               FontSize="12"
                               VerticalOptions="Center" />
                        <Label x:Name="PeriodNameLabel"
                               Text="-"
                               TextColor="#F8FAFC"
                               FontAttributes="Bold"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Loading Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   Color="#38BDF8"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HeightRequest="40" />

                <!-- Empty State -->
                <VerticalStackLayout x:Name="EmptyStateContainer"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40"
                                     IsVisible="False">
                    <Label Text="🏦" FontSize="48" HorizontalOptions="Center" />
                    <Label x:Name="EmptyStateLabel"
                           Text="Tidak ada data balance sheet pada periode ini."
                           TextColor="#94A3B8"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Konten Utama Balance Sheet -->
                <VerticalStackLayout x:Name="SheetContainer" Spacing="16" IsVisible="False">

                    <!-- KARTU ASSETS -->
                    <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="ASSETS" TextColor="#F59E0B" FontSize="12" FontAttributes="Bold" />
                            <CollectionView x:Name="AssetsCollectionView" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                                <Label Text="{Binding ReferenceNumber}" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                                                <Label Text="{Binding AccountName}" TextColor="White" FontSize="13" />
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding FormattedAmount}" TextColor="White" FontSize="13" HorizontalOptions="End" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                            <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                <Label Grid.Column="0" Text="Total Assets" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label x:Name="TotalAssetsLabel" Grid.Column="1" Text="Rp 0" TextColor="#38BDF8" FontSize="15" FontAttributes="Bold" HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- KARTU LIABILITIES -->
                    <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="LIABILITIES" TextColor="#F59E0B" FontSize="12" FontAttributes="Bold" />
                            <CollectionView x:Name="LiabilitiesCollectionView" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                                <Label Text="{Binding ReferenceNumber}" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                                                <Label Text="{Binding AccountName}" TextColor="White" FontSize="13" />
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding FormattedAmount}" TextColor="White" FontSize="13" HorizontalOptions="End" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                            <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                <Label Grid.Column="0" Text="Total Liabilities" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                <Label x:Name="TotalLiabilitiesLabel" Grid.Column="1" Text="Rp 0" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- KARTU EQUITY -->
                    <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="EQUITY" TextColor="#F59E0B" FontSize="12" FontAttributes="Bold" />
                            <CollectionView x:Name="EquityCollectionView" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                                <Label Text="{Binding ReferenceNumber}" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                                                <Label Text="{Binding AccountName}" TextColor="White" FontSize="13" />
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding FormattedAmount}" TextColor="White" FontSize="13" HorizontalOptions="End" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Baris Retained Earnings Ending -->
                            <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="-" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                                    <Label x:Name="RetainedEarningsRowLabel" Text="Retained earnings" TextColor="White" FontSize="13" />
                                </HorizontalStackLayout>
                                <Label x:Name="RetainedEarningsEndingLabel" Grid.Column="1" Text="Rp 0" TextColor="White" FontSize="13" HorizontalOptions="End" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                            <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                <Label Grid.Column="0" Text="Total Equity" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                <Label x:Name="TotalEquityLabel" Grid.Column="1" Text="Rp 0" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- KARTU SUMMARY: TOTAL LIABILITIES & EQUITY -->
                    <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Total Liabilities &amp; Equity" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label x:Name="TotalLiabilitiesAndEquityLabel" Grid.Column="1" Text="Rp 0" TextColor="#38BDF8" FontSize="15" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- Balance Indicator Alert -->
                <Border x:Name="BalanceStatusCard"
                        IsVisible="False"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label x:Name="BalanceStatusIcon" Text="✓" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                        <Label x:Name="BalanceStatusText" Text="Balance sheet seimbang." FontSize="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
