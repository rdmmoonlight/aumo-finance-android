<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.GeneralLedgerPermanentPage"
             BackgroundColor="#0F172A"
             Title="General Ledger - Permanen">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Bar Navigasi Kustom -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <ScrollView Grid.Row="1" Padding="16,10,16,20">
            <VerticalStackLayout Spacing="16">

                <!-- Header Halaman & Tombol Navigasi -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="General Ledger"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Akun Permanen (Ril) — Aset, Liabilitas, Ekuitas"
                               FontSize="12"
                               TextColor="#94A3B8" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="📖  Jurnal Umum"
                            Clicked="OnGeneralJournalClicked"
                            BackgroundColor="#1E293B"
                            BorderColor="#334155"
                            BorderWidth="1"
                            TextColor="#94A3B8"
                            FontAttributes="Bold"
                            FontSize="12"
                            CornerRadius="10"
                            Padding="12,0"
                            HeightRequest="40" />
                </Grid>

                <!-- Indicator Loading -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   Color="#38BDF8"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HeightRequest="40" />

                <!-- Empty State: Jika Periode Belum Dipilih / Tidak Ada Akun -->
                <VerticalStackLayout x:Name="EmptyStateContainer"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40"
                                     IsVisible="False">
                    <Label x:Name="EmptyIconLabel"
                           Text="👁️‍🗨️"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label x:Name="EmptyStateLabel"
                           Text="Tidak ada periode yang dipilih atau akun permanen tidak ditemukan."
                           TextColor="#94A3B8"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- List Akun Permanen (CollectionView Grouped Card) -->
                <CollectionView x:Name="LedgersCollectionView"
                                IsVisible="False"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#1E293B"
                                    Stroke="#334155"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Margin="0,0,0,16"
                                    Padding="16">
                                <VerticalStackLayout Spacing="12">

                                    <!-- Header Card Akun -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                            <Border BackgroundColor="#0F172A"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="6,2">
                                                <Label Text="{Binding ReferenceNumber}"
                                                       TextColor="#F59E0B"
                                                       FontAttributes="Bold"
                                                       FontSize="12" />
                                            </Border>
                                            <Label Text="{Binding AccountName}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   VerticalOptions="Center" />
                                            <Border BackgroundColor="#334155"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="6,2"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Type}"
                                                       TextColor="#CBD5E1"
                                                       FontSize="10" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <!-- Total Saldo Akhir Akun -->
                                        <Label Grid.Column="1"
                                               Text="{Binding FormattedEndingBalance}"
                                               TextColor="{Binding EndingBalanceColor}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#334155" />

                                    <!-- Daftar Transaksi/Posting Akun -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" RowDefinitions="Auto, Auto">
                                                    
                                                    <!-- Tanggal & Deskripsi -->
                                                    <Label Grid.Column="0" Grid.Row="0"
                                                           Text="{Binding EntryDate, StringFormat='{0:dd/MM/yy}'}"
                                                           TextColor="#64748B"
                                                           FontSize="11"
                                                           FontAttributes="Bold" />
                                                    
                                                    <Label Grid.Column="1" Grid.Row="0"
                                                           Text="{Binding Description}"
                                                           TextColor="#CBD5E1"
                                                           FontSize="12"
                                                           LineBreakMode="TailTruncation" />

                                                    <!-- Saldo Running -->
                                                    <Label Grid.Column="2" Grid.Row="0"
                                                           Text="{Binding FormattedRunningBalance}"
                                                           TextColor="White"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           HorizontalOptions="End" />

                                                    <!-- Detail Debet & Kredit -->
                                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="10">
                                                        <Label Text="{Binding FormattedDebit}"
                                                               TextColor="#4ADE80"
                                                               FontSize="10"
                                                               IsVisible="{Binding HasDebit}" />
                                                        <Label Text="{Binding FormattedCredit}"
                                                               TextColor="#F87171"
                                                               FontSize="10"
                                                               IsVisible="{Binding HasCredit}" />
                                                    </HorizontalStackLayout>

                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
