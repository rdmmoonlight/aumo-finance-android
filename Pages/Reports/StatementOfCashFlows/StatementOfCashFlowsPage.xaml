<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.Reports.StatementOfCashFlows.StatementOfCashFlowsPage"
             Title="Cash Flow Statement"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Header Banner -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#0F172A}"
                Padding="16,12"
                StrokeShape="RoundRectangle 0"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="STATEMENT OF CASH FLOWS"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#94A3B8"
                           CharacterSpacing="1" />
                    <Label x:Name="SelectedPeriodHeaderLabel"
                           Text="Loading Active Period..."
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Refresh"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light=#334155, Dark=#1E293B}"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="12,0"
                        HeightRequest="36"
                        Clicked="OnRefreshClicked" />
            </Grid>
        </Border>

        <!-- Main Content Body -->
        <Grid Grid.Row="1" Padding="16">

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               IsVisible="True"
                               HeightRequest="40"
                               WidthRequest="40"
                               Color="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <!-- Empty State View -->
            <VerticalStackLayout x:Name="EmptyStateView"
                                 IsVisible="False"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="💵" FontSize="48" HorizontalOptions="Center" />
                <Label Text="No Cash Flow Data"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                       HorizontalOptions="Center" />
                <Label Text="There are no cash flow activities for the selected period."
                       FontSize="12" TextColor="#94A3B8"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- RefreshView Content Container -->
            <RefreshView x:Name="CashFlowRefreshView" Refreshing="OnRefreshViewRefreshing">
                <ScrollView>
                    <VerticalStackLayout x:Name="MainContentLayout" Spacing="16" IsVisible="False">

                        <!-- 1. Operating Activities Card -->
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                Padding="16" StrokeShape="RoundRectangle 12"
                                StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="A. Operating Activities" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#334155}" />

                                <VerticalStackLayout x:Name="OperatingItemsLayout" Spacing="6" />

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,4,0,0" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Net Cash from Operating" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                    <Label x:Name="NetOperatingLabel" Grid.Column="1" FontSize="11" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- 2. Investing Activities Card -->
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                Padding="16" StrokeShape="RoundRectangle 12"
                                StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="B. Investing Activities" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#334155}" />

                                <VerticalStackLayout x:Name="InvestingItemsLayout" Spacing="6" />

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,4,0,0" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Net Cash from Investing" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                    <Label x:Name="NetInvestingLabel" Grid.Column="1" FontSize="11" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- 3. Financing Activities Card -->
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                Padding="16" StrokeShape="RoundRectangle 12"
                                StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="C. Financing Activities" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#334155}" />

                                <VerticalStackLayout x:Name="FinancingItemsLayout" Spacing="6" />

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,4,0,0" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Net Cash from Financing" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                    <Label x:Name="NetFinancingLabel" Grid.Column="1" FontSize="11" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- 4. Summary Reconciliation Card -->
                        <Border BackgroundColor="{AppThemeBinding Light=#F0F9FF, Dark=#0C4A6E}"
                                Padding="16" StrokeShape="RoundRectangle 12"
                                StrokeThickness="1" Stroke="{AppThemeBinding Light=#BAE6FD, Dark=#0284C7}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="SUMMARY RECONCILIATION" FontSize="11" FontAttributes="Bold" TextColor="#0284C7" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Net Change in Cash" FontSize="11" TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                    <Label x:Name="NetChangeCashLabel" Grid.Column="1" FontSize="11" FontAttributes="Bold" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Beginning Cash Balance" FontSize="11" TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                    <Label x:Name="BeginningCashLabel" Grid.Column="1" FontSize="11" TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#BAE6FD, Dark=#0284C7}" Margin="0,2" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Ending Cash Balance" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0369A1, Dark=#38BDF8}" />
                                    <Label x:Name="EndingCashLabel" Grid.Column="1" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0369A1, Dark=#38BDF8}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
