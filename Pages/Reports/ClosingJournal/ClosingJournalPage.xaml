<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Reports.ClosingJournal.ClosingJournalPage"
             Title="Closing Journal"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid RowDefinitions="Auto, Auto, *">

        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <!-- Top Header Banner -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#0F172A}"
                Padding="16,12"
                StrokeShape="RoundRectangle 0"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="CLOSING JOURNAL REPORT"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#94A3B8"
                           CharacterSpacing="1" />
                    <Label x:Name="SelectedPeriodHeaderLabel"
                           Text="Loading Active Period..."
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Refresh"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light=#334155, Dark=#1E293B}"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="12,0"
                        HeightRequest="36"
                        Clicked="OnRefreshClicked" />
            </Grid>
        </Border>

        <!-- Main Content Body -->
        <Grid Grid.Row="2" Padding="16">

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               IsVisible="True"
                               HeightRequest="40"
                               WidthRequest="40"
                               Color="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <!-- Empty State View -->
            <VerticalStackLayout x:Name="EmptyStateView"
                                 IsVisible="False"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="🔒" FontSize="48" HorizontalOptions="Center" />
                <Label Text="No Closing Journal Entries"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                       HorizontalOptions="Center" />
                <Label Text="There are no closing entries available for the selected period."
                       FontSize="12" TextColor="#94A3B8"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Main Content Container -->
            <RefreshView x:Name="JournalRefreshView" Refreshing="OnRefreshViewRefreshing">
                <ScrollView>
                    <VerticalStackLayout Spacing="16">

                        <!-- Summary Net Income Card -->
                        <Border x:Name="NetIncomeCard"
                                BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                                Stroke="{AppThemeBinding Light=#A7F3D0, Dark=#065F46}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="16"
                                IsVisible="False">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="NET INCOME (LABA BERSIH)"
                                           FontSize="10" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#047857, Dark=#6EE7B7}" />
                                    <Label x:Name="RetainedEarningsAccountLabel"
                                           Text="Laba Ditahan"
                                           FontSize="12" TextColor="{AppThemeBinding Light=#065F46, Dark=#A7F3D0}" />
                                </VerticalStackLayout>
                                <Label x:Name="NetIncomeLabel"
                                       Grid.Column="1"
                                       Text="Rp 0"
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#047857, Dark=#34D399}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Groups List Collection -->
                        <CollectionView x:Name="JournalCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,16"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                            Padding="16"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">

                                        <VerticalStackLayout Spacing="10">

                                            <!-- Group Header (Description) -->
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Description}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                <Border Grid.Column="1"
                                                        BackgroundColor="#FEF3C7"
                                                        StrokeShape="RoundRectangle 6"
                                                        StrokeThickness="0"
                                                        Padding="6,2">
                                                    <Label Text="CLOSING"
                                                           FontSize="10" FontAttributes="Bold"
                                                           TextColor="#D97706" />
                                                </Border>
                                            </Grid>

                                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#334155}" />

                                            <!-- Header Line -->
                                            <Grid ColumnDefinitions="1.5*, 3.5*, Auto, Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="Ref #" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                                                <Label Grid.Column="1" Text="Account" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                                                <Label Grid.Column="2" Text="Debit" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" HorizontalTextAlignment="End" WidthRequest="75" />
                                                <Label Grid.Column="3" Text="Credit" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" HorizontalTextAlignment="End" WidthRequest="75" />
                                            </Grid>

                                            <!-- Lines Item Repeater -->
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="4">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="1.5*, 3.5*, Auto, Auto" ColumnSpacing="8" Margin="0,2">
                                                            <Label Grid.Column="0" Text="{Binding FormattedRef}" FontSize="11" TextColor="#64748B" />
                                                            <Label Grid.Column="1" Text="{Binding AccountName}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" LineBreakMode="TailTruncation" />
                                                            <Label Grid.Column="2" Text="{Binding FormattedDebit}" FontSize="11" TextColor="#166534" HorizontalTextAlignment="End" WidthRequest="75" />
                                                            <Label Grid.Column="3" Text="{Binding FormattedCredit}" FontSize="11" TextColor="#991B1B" HorizontalTextAlignment="End" WidthRequest="75" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,4,0,0" />

                                            <!-- Group Total Footer -->
                                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="Total" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding FormattedTotalDebit}" FontSize="11" FontAttributes="Bold" TextColor="#166534" HorizontalTextAlignment="End" WidthRequest="75" />
                                                <Label Grid.Column="2" Text="{Binding FormattedTotalCredit}" FontSize="11" FontAttributes="Bold" TextColor="#991B1B" HorizontalTextAlignment="End" WidthRequest="75" />
                                            </Grid>

                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
