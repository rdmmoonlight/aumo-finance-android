<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.Periods.PeriodsPage"
             Title="Accounting Periods"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Navigation Bar (Disamakan dengan halaman lain) -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *" Padding="20,20,20,0" RowSpacing="20">

            <!-- Page Header Card -->
            <Border Grid.Row="0"
                    BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,12">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="PERIOD MANAGEMENT"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#94A3B8"
                               CharacterSpacing="0.8" />
                        <Label x:Name="ActivePeriodHeaderLabel"
                               Text="Loading Active Period..."
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="➕ New Period"
                            Clicked="OnAddPeriodClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="12"
                            CornerRadius="10"
                            Padding="12,0"
                            HeightRequest="40" />
                </Grid>
            </Border>

            <!-- Loading Indicator Overlay -->
            <ActivityIndicator Grid.Row="1"
                               x:Name="LoadingIndicator"
                               IsRunning="True"
                               IsVisible="True"
                               HeightRequest="40"
                               WidthRequest="40"
                               Color="#38BDF8"
                               HorizontalOptions="Center" />

            <!-- Empty state + list share the remaining space -->
            <Grid Grid.Row="2">

                <!-- Empty State View -->
                <VerticalStackLayout x:Name="EmptyStateView"
                                     IsVisible="False"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="0,40">
                    <Label Text="📅"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="No Accounting Periods Found"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#CBD5E1"
                           HorizontalOptions="Center" />
                    <Label Text="Tap '+ New Period' above to create your first accounting period."
                           FontSize="12"
                           TextColor="#94A3B8"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Periods Collection List: CollectionView provides its own scrolling/virtualization,
                     so it must not be nested inside a ScrollView. -->
                <RefreshView x:Name="PeriodsRefreshView"
                             BackgroundColor="#0F172A"
                             RefreshColor="#38BDF8"
                             Refreshing="OnRefreshViewRefreshing">
                    <CollectionView x:Name="PeriodsCollectionView"
                                    SelectionMode="None"
                                    Margin="0,0,0,40">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12"
                                        BackgroundColor="#1E293B"
                                        Padding="16"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1"
                                        Stroke="#334155">
                                    <Border.Shadow>
                                        <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                                    </Border.Shadow>

                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="8">

                                        <!-- Period Name & Badges -->
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                            <Label Text="{Binding PeriodName}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   VerticalOptions="Center" />

                                            <!-- Selected Active Badge -->
                                            <Border IsVisible="{Binding IsSelected}"
                                                    BackgroundColor="#14532D"
                                                    StrokeShape="RoundRectangle 6"
                                                    StrokeThickness="0"
                                                    Padding="6,2"
                                                    VerticalOptions="Center">
                                                <Label Text="ACTIVE"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#86EFAC" />
                                            </Border>

                                            <!-- Closed Badge -->
                                            <Border IsVisible="{Binding IsClosed}"
                                                    BackgroundColor="#7F1D1D"
                                                    StrokeShape="RoundRectangle 6"
                                                    StrokeThickness="0"
                                                    Padding="6,2"
                                                    VerticalOptions="Center">
                                                <Label Text="CLOSED"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#FCA5A5" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <!-- Date Range -->
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding DateRangeDisplay}"
                                               FontSize="12"
                                               TextColor="#94A3B8" />

                                        <!-- Actions (Select / Close) -->
                                        <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                                               Spacing="8" 
                                                               Margin="0,4,0,0">

                                            <!-- Select Period Button -->
                                            <Button Text="Select Period"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    HeightRequest="32"
                                                    CornerRadius="8"
                                                    Padding="12,0"
                                                    BackgroundColor="#334155"
                                                    TextColor="#38BDF8"
                                                    IsVisible="{Binding CanSelect}"
                                                    Clicked="OnSelectPeriodClicked" />

                                            <!-- Close Period Button -->
                                            <Button Text="Close Period"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    HeightRequest="32"
                                                    CornerRadius="8"
                                                    Padding="12,0"
                                                    BackgroundColor="#7F1D1D"
                                                    TextColor="#FCA5A5"
                                                    IsVisible="{Binding CanClose}"
                                                    Clicked="OnClosePeriodClicked" />
                                        </HorizontalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>

        </Grid>

    </Grid>

</ContentPage>
