<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.Periods.PeriodsPage"
             Title="Accounting Periods"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Action Header Banner -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#0F172A}"
                Padding="16,12"
                StrokeShape="RoundRectangle 0"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="PERIOD MANAGEMENT"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#94A3B8"
                           CharacterSpacing="1" />
                    <Label x:Name="ActivePeriodHeaderLabel"
                           Text="Loading Active Period..."
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="+ New Period"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#1D4ED8}"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="12,0"
                        HeightRequest="36"
                        Clicked="OnAddPeriodClicked" />
            </Grid>
        </Border>

        <!-- Main Body Content -->
        <Grid Grid.Row="1" Padding="16">

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               IsVisible="True"
                               HeightRequest="40"
                               WidthRequest="40"
                               Color="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <!-- Empty State View -->
            <VerticalStackLayout x:Name="EmptyStateView"
                                 IsVisible="False"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="📅"
                       FontSize="48"
                       HorizontalOptions="Center" />
                <Label Text="No Accounting Periods Found"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                       HorizontalOptions="Center" />
                <Label Text="Tap '+ New Period' above to create your first accounting period."
                       FontSize="12"
                       TextColor="#94A3B8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Periods Collection List -->
            <RefreshView x:Name="PeriodsRefreshView"
                         Refreshing="OnRefreshViewRefreshing">
                <CollectionView x:Name="PeriodsCollectionView"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                    Padding="16"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">

                                    <!-- Period Name & Badges -->
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                                        <Label Text="{Binding PeriodName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                               VerticalOptions="Center" />

                                        <!-- Selected Active Badge -->
                                        <Border IsVisible="{Binding IsSelected}"
                                                BackgroundColor="#DCFCE7"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                Padding="6,2"
                                                VerticalOptions="Center">
                                            <Label Text="ACTIVE"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="#166534" />
                                        </Border>

                                        <!-- Closed Badge -->
                                        <Border IsVisible="{Binding IsClosed}"
                                                BackgroundColor="#FEE2E2"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                Padding="6,2"
                                                VerticalOptions="Center">
                                            <Label Text="CLOSED"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="#991B1B" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Date Range -->
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding DateRangeDisplay}"
                                           FontSize="12"
                                           TextColor="#64748B" />

                                    <!-- Actions (Select / Close) -->
                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                                           Spacing="8" 
                                                           Margin="0,8,0,0">

                                        <!-- Select Period Button -->
                                        <Button Text="Select Period"
                                                FontSize="11"
                                                HeightRequest="32"
                                                CornerRadius="6"
                                                Padding="12,0"
                                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#334155}"
                                                TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                                IsVisible="{Binding CanSelect}"
                                                Clicked="OnSelectPeriodClicked"
                                                CommandParameter="{Binding .}" />

                                        <!-- Close Period Button -->
                                        <Button Text="Close Period"
                                                FontSize="11"
                                                HeightRequest="32"
                                                CornerRadius="6"
                                                Padding="12,0"
                                                BackgroundColor="#DC2626"
                                                TextColor="White"
                                                IsVisible="{Binding CanClose}"
                                                Clicked="OnClosePeriodClicked"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
