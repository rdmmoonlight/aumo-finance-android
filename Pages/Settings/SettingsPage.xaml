<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.Settings.SettingsPage"
             BackgroundColor="#0F172A"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Section: Daily Reminder Notifications -->
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.3" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    
                    <!-- Title & Header -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                BackgroundColor="#312E81"
                                Stroke="#4F46E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="40"
                                WidthRequest="40"
                                VerticalOptions="Center">
                            <Label Text="&#xE7F4;"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="#818CF8"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Daily Reminder"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Get reminded to log your daily financial transactions"
                                   FontSize="12"
                                   TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                    <!-- Toggle Enable/Disable Notification -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Enable Daily Reminder"
                               FontSize="14"
                               TextColor="#CBD5E1"
                               VerticalOptions="Center" />
                        <Switch x:Name="ReminderSwitch"
                                Grid.Column="1"
                                OnColor="#4F46E5"
                                ThumbColor="White"
                                Toggled="OnReminderToggled" />
                    </Grid>

                    <!-- Time Picker Container -->
                    <VerticalStackLayout x:Name="TimePickerContainer" Spacing="8">
                        <Label Text="Reminder Time"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#94A3B8" />

                        <Border BackgroundColor="#0F172A"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,4">
                            <TimePicker x:Name="ReminderTimePicker"
                                        TextColor="White"
                                        FontSize="15"
                                        Format="hh:mm tt"
                                        TimeSelected="OnTimeSelected" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button x:Name="SaveButton"
                    Text="Save Settings"
                    Clicked="OnSaveSettingsClicked"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="12"
                    HeightRequest="48"
                    Margin="0,10,0,0">
                <Button.Shadow>
                    <Shadow Brush="#4F46E5" Offset="0,4" Radius="10" Opacity="0.35" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
