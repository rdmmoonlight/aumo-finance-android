<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.LoginPage"
             BackgroundColor="#0F172A"
             NavigationPage.HasNavigationBar="False"
             Title="Login">

    <Grid VerticalOptions="Center" Padding="24">
        
        <!-- Card Container Login -->
        <Border BackgroundColor="#1E293B"
                Stroke="#334155"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="24">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,10" Radius="20" Opacity="0.4" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20">

                <!-- Header & App Logo/Icon -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border BackgroundColor="#312E81"
                            Stroke="#4F46E5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            HeightRequest="64"
                            WidthRequest="64"
                            HorizontalOptions="Center"
                            Margin="0,0,0,10">
                        <Label Text="💎" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    
                    <Label Text="AumoFinance"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    
                    <Label Text="Masuk ke akun Anda untuk melanjutkan"
                           FontSize="12"
                           TextColor="#94A3B8"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Alert/Error Box -->
                <Border x:Name="ErrorCard"
                        IsVisible="False"
                        BackgroundColor="#7F1D1D"
                        Stroke="#DC2626"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,8">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="⚠️" VerticalOptions="Center" />
                        <Label x:Name="ErrorText"
                               Text="Email atau password salah."
                               TextColor="#FCA5A5"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Input Username / Email -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email / Username"
                           TextColor="#CBD5E1"
                           FontSize="12"
                           FontAttributes="Bold" />
                    
                    <Border BackgroundColor="#0F172A"
                            Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,2">
                        <Entry x:Name="UsernameEntry"
                               Placeholder="nama@email.com"
                               PlaceholderColor="#64748B"
                               TextColor="White"
                               Keyboard="Email"
                               ReturnType="Next" />
                    </Border>
                </VerticalStackLayout>

                <!-- Input Password -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Password"
                               TextColor="#CBD5E1"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Grid>
                    
                    <Border BackgroundColor="#0F172A"
                            Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,2">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="0"
                                   Placeholder="••••••••"
                                   PlaceholderColor="#64748B"
                                   TextColor="White"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   Completed="OnLoginButtonClicked" />
                            
                            <Button x:Name="TogglePasswordButton"
                                    Grid.Column="1"
                                    Text="👁️"
                                    BackgroundColor="Transparent"
                                    TextColor="#94A3B8"
                                    FontSize="14"
                                    Padding="0"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Button Login & Indicator -->
                <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       Color="#4F46E5"
                                       IsRunning="False"
                                       IsVisible="False"
                                       HeightRequest="36" />

                    <Button x:Name="LoginButton"
                            Text="Masuk"
                            Clicked="OnLoginButtonClicked"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="50">
                        <Button.Shadow>
                            <Shadow Brush="#4F46E5" Offset="0,4" Radius="8" Opacity="0.4" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
