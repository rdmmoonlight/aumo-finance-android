<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.LoginPage"
             BackgroundColor="#0F172A"
             NavigationPage.HasNavigationBar="False"
             Title="Login">

    <Grid VerticalOptions="Center" Padding="24">
        
        <!-- Login Card Container -->
        <Border BackgroundColor="#1E293B"
                Stroke="#334155"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="28,32">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,12" Radius="24" Opacity="0.45" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="24">

                <!-- Header & App Logo/Icon -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="#312E81"
                            Stroke="#4F46E5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            HeightRequest="60"
                            WidthRequest="60"
                            HorizontalOptions="Center"
                            Margin="0,0,0,8">
                        <Label Text="A" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="#818CF8" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Border>
                    
                    <Label Text="AumoFinance"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    
                    <Label Text="Sign in to your account to continue"
                           FontSize="13"
                           TextColor="#94A3B8"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Alert / Error Box -->
                <Border x:Name="ErrorCard"
                        IsVisible="False"
                        BackgroundColor="#450A0A"
                        Stroke="#DC2626"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,10">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="!" 
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#FCA5A5" 
                               VerticalOptions="Center" />
                        <Label x:Name="ErrorText"
                               Text="Invalid email or password."
                               TextColor="#FCA5A5"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Input Username / Email -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email or Username"
                           TextColor="#CBD5E1"
                           FontSize="12"
                           FontAttributes="Bold" />
                    
                    <Border BackgroundColor="#0F172A"
                            Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,2">
                        <Entry x:Name="UsernameEntry"
                               Placeholder="name@example.com"
                               PlaceholderColor="#475569"
                               TextColor="White"
                               Keyboard="Email"
                               ReturnType="Next"
                               FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Input Password -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Password"
                           TextColor="#CBD5E1"
                           FontSize="12"
                           FontAttributes="Bold" />
                    
                    <Border BackgroundColor="#0F172A"
                            Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,2">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="0"
                                   Placeholder="••••••••"
                                   PlaceholderColor="#475569"
                                   TextColor="White"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   FontSize="14"
                                   Completed="OnLoginButtonClicked" />
                            
                            <Button x:Name="TogglePasswordButton"
                                   Grid.Column="1"
                                   Text="SHOW"
                                   BackgroundColor="Transparent"
                                   TextColor="#64748B"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   Padding="8,0"
                                   HeightRequest="36"
                                   Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Action Button & Loading Indicator -->
                <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       Color="#6366F1"
                                       IsRunning="False"
                                       IsVisible="False"
                                       HeightRequest="36" />

                    <Button x:Name="LoginButton"
                            Text="Sign In"
                            Clicked="OnLoginButtonClicked"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="50">
                        <Button.Shadow>
                            <Shadow Brush="#4F46E5" Offset="0,4" Radius="12" Opacity="0.35" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
