<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.Auth.LoginPage"
             BackgroundColor="#0F172A"
             NavigationPage.HasNavigationBar="False"
             Title="Log In">

    <Grid VerticalOptions="Center" Padding="24">
        
        <!-- Login Card Container -->
        <Border BackgroundColor="#1E293B"
                Stroke="#334155"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="28,32">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,12" Radius="24" Opacity="0.45" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20">

                <!-- Header & App Logo/Icon -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="#312E81"
                            Stroke="#4F46E5"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 20"
                            HeightRequest="60"
                            WidthRequest="60"
                            HorizontalOptions="Center"
                            Margin="0,0,0,8">
                        <Image Source="appicon.png"
                               HeightRequest="45"
                               WidthRequest="45"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    
                    <Label Text="AumoFinance"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           CharacterSpacing="0.5" />
                    
                    <Label Text="Log in to your account to continue"
                           FontSize="13"
                           TextColor="#94A3B8"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Alert/Error Box -->
                <Border x:Name="ErrorCard"
                        IsVisible="False"
                        BackgroundColor="#451A1A"
                        Stroke="#F87171"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,10">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="&#xE000;"
                               FontFamily="MaterialIcons"
                               TextColor="#FCA5A5"
                               FontSize="16"
                               VerticalOptions="Center" />
                        <Label x:Name="ErrorText"
                               Grid.Column="1"
                               Text="Invalid email or password."
                               TextColor="#FCA5A5"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Input Form Wrapper -->
                <VerticalStackLayout Spacing="16">

                    <!-- Email Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email"
                               TextColor="#CBD5E1"
                               FontSize="12"
                               FontAttributes="Bold" />
                        
                        <Border BackgroundColor="#0F172A"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,2">
                            <Entry x:Name="EmailEntry"
                                   Placeholder="name@email.com"
                                   PlaceholderColor="#64748B"
                                   TextColor="White"
                                   FontSize="14"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   HeightRequest="44" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               TextColor="#CBD5E1"
                               FontSize="12"
                               FontAttributes="Bold" />
                        
                        <Border BackgroundColor="#0F172A"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,2">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="0"
                                       Placeholder="••••••••"
                                       PlaceholderColor="#64748B"
                                       TextColor="White"
                                       FontSize="14"
                                       IsPassword="True"
                                       ReturnType="Done"
                                       HeightRequest="44"
                                       VerticalOptions="Center"
                                       Completed="OnLoginButtonClicked" />
                                
                                <Button x:Name="TogglePasswordButton"
                                        Grid.Column="1"
                                        Text="&#xE8F5;"
                                        FontFamily="MaterialIcons"
                                        BackgroundColor="Transparent"
                                        TextColor="#94A3B8"
                                        FontSize="20"
                                        Padding="0"
                                        BorderWidth="0"
                                        CornerRadius="0"
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        VerticalOptions="Center"
                                        Clicked="OnTogglePasswordClicked" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Remember Me Checkbox -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                        <CheckBox x:Name="RememberMeCheckBox"
                                  Grid.Column="0"
                                  Color="#6366F1"
                                  VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Remember me"
                               TextColor="#94A3B8"
                               FontSize="13"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRememberMeLabelTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                </VerticalStackLayout>

                <!-- Login Button, Biometrics & Indicator -->
                <VerticalStackLayout Spacing="12" Margin="0,4,0,0">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       Color="#6366F1"
                                       IsRunning="False"
                                       IsVisible="False"
                                       HeightRequest="36" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Button x:Name="LoginButton"
                                Grid.Column="0"
                                Text="Log In"
                                Clicked="OnLoginButtonClicked"
                                BackgroundColor="#4F46E5"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="15"
                                CornerRadius="12"
                                HeightRequest="48">
                            <Button.Shadow>
                                <Shadow Brush="#4F46E5" Offset="0,6" Radius="12" Opacity="0.35" />
                            </Button.Shadow>
                        </Button>

                        <!-- Biometric Login Button -->
                        <Button x:Name="BiometricButton"
                                Grid.Column="1"
                                Text="&#xE90D;" 
                                FontFamily="MaterialIcons"
                                FontSize="24"
                                BackgroundColor="#312E81"
                                TextColor="#818CF8"
                                BorderColor="#4F46E5"
                                BorderWidth="1"
                                CornerRadius="12"
                                HeightRequest="48"
                                WidthRequest="48"
                                IsVisible="False"
                                Clicked="OnBiometricButtonClicked" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
