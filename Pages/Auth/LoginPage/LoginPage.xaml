<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.Auth.LoginPage"
             BackgroundColor="#14161C"
             NavigationPage.HasNavigationBar="False"
             Title="Log In">

    <Grid VerticalOptions="Center" Padding="24">

        <!-- Login Card Container -->
        <Border BackgroundColor="#1B1E27"
                Stroke="#2B2F3A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="28,32">

            <VerticalStackLayout Spacing="20">

                <!-- Header & App Logo/Icon -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="#262A36"
                            Stroke="#3A3F4E"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            HeightRequest="60"
                            WidthRequest="60"
                            HorizontalOptions="Center"
                            Margin="0,0,0,8">
                        <Image Source="appicon.png"
                               HeightRequest="45"
                               WidthRequest="45"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="AumoFinance"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#E7E9EE"
                           HorizontalTextAlignment="Center"
                           CharacterSpacing="0.5" />

                    <Label Text="Log in to your account to continue"
                           FontSize="13"
                           TextColor="#8B93A6"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Alert/Error Box -->
                <Border x:Name="ErrorCard"
                        IsVisible="False"
                        BackgroundColor="#2A1F1F"
                        Stroke="#5E3D3D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,10">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="&#xea05;"
                               FontFamily="TablerIcons"
                               TextColor="#C98F8F"
                               FontSize="16"
                               VerticalOptions="Center" />
                        <Label x:Name="ErrorText"
                               Grid.Column="1"
                               Text="Invalid email or password."
                               TextColor="#C98F8F"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Input Form Wrapper -->
                <VerticalStackLayout Spacing="16">

                    <!-- Email Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email"
                               TextColor="#B7BECC"
                               FontSize="12"
                               FontAttributes="Bold" />

                        <Border BackgroundColor="#10121A"
                                Stroke="#2B2F3A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,2">
                            <Entry x:Name="EmailEntry"
                                   Placeholder="name@email.com"
                                   PlaceholderColor="#5B6274"
                                   TextColor="#E7E9EE"
                                   FontSize="14"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   HeightRequest="44" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               TextColor="#B7BECC"
                               FontSize="12"
                               FontAttributes="Bold" />

                        <Border BackgroundColor="#10121A"
                                Stroke="#2B2F3A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,2">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="0"
                                       Placeholder="••••••••"
                                       PlaceholderColor="#5B6274"
                                       TextColor="#E7E9EE"
                                       FontSize="14"
                                       IsPassword="True"
                                       ReturnType="Done"
                                       HeightRequest="44"
                                       VerticalOptions="Center"
                                       Completed="OnLoginButtonClicked" />

                                <Button x:Name="TogglePasswordButton"
                                        Grid.Column="1"
                                        Text="&#xecf0;"
                                        FontFamily="TablerIcons"
                                        BackgroundColor="Transparent"
                                        TextColor="#8B93A6"
                                        FontSize="20"
                                        Padding="0"
                                        BorderWidth="0"
                                        CornerRadius="0"
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        VerticalOptions="Center"
                                        Clicked="OnTogglePasswordClicked" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Remember Me Checkbox -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                        <CheckBox x:Name="RememberMeCheckBox"
                                  Grid.Column="0"
                                  Color="#5B6488"
                                  VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Remember me"
                               TextColor="#8B93A6"
                               FontSize="13"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRememberMeLabelTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                </VerticalStackLayout>

                <!-- Login Button, Biometrics & Indicator -->
                <VerticalStackLayout Spacing="12" Margin="0,4,0,0">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       Color="#5B6488"
                                       IsRunning="False"
                                       IsVisible="False"
                                       HeightRequest="36" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Button x:Name="LoginButton"
                                Grid.Column="0"
                                Text="Log In"
                                Clicked="OnLoginButtonClicked"
                                BackgroundColor="#464C63"
                                TextColor="#E7E9EE"
                                FontAttributes="Bold"
                                FontSize="15"
                                CornerRadius="12"
                                HeightRequest="48" />

                        <!-- Biometric Login Button -->
                        <Button x:Name="BiometricButton"
                                Grid.Column="1"
                                Text="&#xebd1;"
                                FontFamily="TablerIcons"
                                FontSize="22"
                                BackgroundColor="#262A36"
                                TextColor="#9AA3C2"
                                BorderColor="#3A3F4E"
                                BorderWidth="1"
                                CornerRadius="12"
                                HeightRequest="48"
                                WidthRequest="48"
                                IsVisible="False"
                                Clicked="OnBiometricButtonClicked" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
