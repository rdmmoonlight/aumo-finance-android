<!-- FLOATING ACTION BUTTONS (FAB) -->
<VerticalStackLayout VerticalOptions="End" 
                     HorizontalOptions="End" 
                     Margin="0,0,20,24" 
                     Spacing="10"
                     ZIndex="999">

    <!-- Tombol 3 (Baru): Navigasi ke Dashboard -->
    <Button Text="📊 Dashboard"
            BackgroundColor="#334155"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="12"
            CornerRadius="20"
            HeightRequest="40"
            Padding="16,0"
            Clicked="OnDashboardFabClicked">
        <Button.Shadow>
            <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.3" />
        </Button.Shadow>
    </Button>

    <!-- Tombol 2: Refresh -->
    <Button Text="🔄 Refresh"
            BackgroundColor="#334155"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="12"
            CornerRadius="20"
            HeightRequest="40"
            Padding="16,0"
            Clicked="OnRefreshClicked">
        <Button.Shadow>
            <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.3" />
        </Button.Shadow>
    </Button>

    <!-- Tombol 1: Primary Entry -->
    <Button Text="➕ Entry"
            BackgroundColor="#2563EB"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="13"
            CornerRadius="24"
            HeightRequest="48"
            Padding="18,0"
            Clicked="OnPrimaryFabClicked">
        <Button.Shadow>
            <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.4" />
        </Button.Shadow>
    </Button>

</VerticalStackLayout>
