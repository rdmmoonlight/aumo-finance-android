<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AumoFinance.Views"
             x:Class="AumoFinance.Pages.MainPage"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Top Bar Component -->
        <views:TopBarView x:Name="TopHeader" Grid.Row="0" />

        <!-- Main Home Content -->
        <ScrollView Grid.Row="1" Padding="20,20,20,40">
            <VerticalStackLayout Spacing="24">

                <!-- Greetings Section -->
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="GreetingLabel"
                           Text="Good Morning,"
                           TextColor="#94A3B8"
                           FontSize="16" />
                    <Label x:Name="UserNameLabel"
                           Text="Tri Wahyu Abdul Ghofur"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="24" />
                </VerticalStackLayout>

                <!-- Quick Actions Grid -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                    <!-- Go To Dashboard Button -->
                    <Button Grid.Column="0"
                            Text="📊 Dashboard"
                            BackgroundColor="#1E293B"
                            TextColor="#38BDF8"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="56"
                            Clicked="OnDashboardFabClicked" />

                    <!-- Go To New Entry Button -->
                    <Button Grid.Column="1"
                            Text="➕ New Entry"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="56"
                            Clicked="OnPrimaryFabClicked" />
                </Grid>

                <!-- SYSTEM UPDATES CARD -->
                <Border BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16"
                        Margin="0,10,0,0">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="SYSTEM SETTINGS"
                               TextColor="#94A3B8"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8" />

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Auto-Update from GitHub"
                                       TextColor="White"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                                <Label Text="Keep app up to date automatically"
                                       TextColor="#64748B"
                                       FontSize="10" />
                            </VerticalStackLayout>
                            <Switch x:Name="AutoUpdateSwitch"
                                    Grid.Column="1"
                                    OnColor="#4F46E5"
                                    ThumbColor="White"
                                    Toggled="OnAutoUpdateToggled" />
                        </Grid>

                        <Button Text="Check for Updates"
                                BackgroundColor="#334155"
                                TextColor="#38BDF8"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="10"
                                HeightRequest="40"
                                Clicked="OnCheckUpdateManualClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
