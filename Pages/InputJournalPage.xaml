<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.InputJournalPage"
             BackgroundColor="#0F172A">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <!-- Title Header -->
            <Label Text="Input Transaksi" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="White" />

            <!-- Selector Pemasukan / Pengeluaran -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <!-- Button Pemasukan -->
                <Button x:Name="IncomeBtn"
                        Grid.Column="0"
                        Text="💰 Pemasukan"
                        Clicked="OnIncomeTypeSelected"
                        BackgroundColor="#1E293B"
                        BorderColor="#334155"
                        BorderWidth="1"
                        TextColor="#94A3B8"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48" />

                <!-- Button Pengeluaran (Default Selected) -->
                <Button x:Name="ExpenseBtn"
                        Grid.Column="1"
                        Text="💸 Pengeluaran"
                        Clicked="OnExpenseTypeSelected"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48" />
            </Grid>

            <!-- Field Tanggal -->
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Tanggal" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" />
                    <DatePicker x:Name="EntryDatePicker"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Field Nominal -->
            <Border x:Name="AmountFieldBorder"
                    BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,8">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="AmountTypeLabel" 
                           Text="Nominal Pengeluaran (Rp)" 
                           TextColor="#F87171" 
                           FontSize="11" 
                           FontAttributes="Bold" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Rp"
                               TextColor="#94A3B8"
                               FontSize="20"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Entry x:Name="AmountEntry"
                               Grid.Column="1"
                               Placeholder="0"
                               PlaceholderColor="#64748B"
                               Keyboard="Numeric"
                               TextChanged="OnAmountTextChanged"
                               Focused="OnAmountFocused"
                               Unfocused="OnAmountUnfocused"
                               TextColor="White"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Fill" />
                    </Grid>
                    <Label x:Name="AmountValidationLabel"
                           Text="Nominal harus lebih besar dari 0"
                           TextColor="#F87171"
                           FontSize="10"
                           IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <!-- Field Catatan -->
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Catatan" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="NoteEntry"
                           Placeholder="Contoh: Beli makanan, Bayar listrik"
                           PlaceholderColor="#64748B"
                           TextColor="White"
                           FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                <!-- Batal -->
                <Button Grid.Column="0"
                        Text="Batal"
                        Clicked="OnCancelClicked"
                        BackgroundColor="#1E293B"
                        BorderColor="#334155"
                        BorderWidth="1"
                        TextColor="#94A3B8"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50" />

                <!-- Simpan -->
                <Button Grid.Column="1"
                        Text="Simpan"
                        Clicked="OnSaveClicked"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
