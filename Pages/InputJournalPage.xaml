<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.Pages.InputJournalPage"
             BackgroundColor="#0F172A"
             Title="INPUT JURNAL BARU">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Input Transaksi Pemasukan / Pengeluaran"
                   TextColor="#38BDF8"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Pilihan Jenis Transaksi -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button x:Name="IncomeBtn"
                        Grid.Column="0"
                        Text="Pemasukan"
                        HeightRequest="48"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        Clicked="OnIncomeSelected" />

                <Button x:Name="ExpenseBtn"
                        Grid.Column="1"
                        Text="Pengeluaran"
                        HeightRequest="48"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        Clicked="OnExpenseSelected" />
            </Grid>

            <!-- Tanggal Transaksi -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Tanggal Transaksi"
                       TextColor="#94A3B8"
                       FontSize="14" />
                <Border Stroke="#334155"
                        StrokeThickness="1"
                        Background="#1E293B"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">
                    <DatePicker x:Name="EntryDatePicker"
                                TextColor="White"
                                Format="dd/MM/yyyy"
                                HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Nominal -->
            <VerticalStackLayout Spacing="6">
                <Label x:Name="AmountTypeLabel"
                       Text="Nominal Pemasukan (Rp)"
                       TextColor="#38BDF8"
                       FontSize="14" />
                <Border x:Name="AmountFieldBorder"
                        Stroke="#334155"
                        StrokeThickness="1"
                        Background="#1E293B"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">
                    <Entry x:Name="AmountEntry"
                           Placeholder="0"
                           PlaceholderColor="#64748B"
                           TextColor="White"
                           Keyboard="Numeric"
                           HeightRequest="48"
                           TextChanged="OnAmountTextChanged"
                           Focused="OnAmountFocused"
                           Unfocused="OnAmountUnfocused" />
                </Border>
                <Label x:Name="AmountValidationLabel"
                       Text="Nominal harus lebih dari 0"
                       TextColor="#F87171"
                       FontSize="12"
                       IsVisible="False" />
            </VerticalStackLayout>

            <!-- Catatan -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Catatan / Keterangan"
                       TextColor="#94A3B8"
                       FontSize="14" />
                <Border Stroke="#334155"
                        StrokeThickness="1"
                        Background="#1E293B"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">
                    <Entry x:Name="NoteEntry"
                           Placeholder="Masukkan catatan transaksi (opsional)"
                           PlaceholderColor="#64748B"
                           TextColor="White"
                           HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Tombol Aksi -->
            <Button x:Name="SaveBtn"
                    Text="SIMPAN TRANSAKSI"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="52"
                    CornerRadius="10"
                    Margin="0,15,0,0"
                    Clicked="OnSaveClicked" />

            <Button Text="Batal"
                    BackgroundColor="Transparent"
                    TextColor="#94A3B8"
                    BorderColor="#334155"
                    BorderWidth="1"
                    HeightRequest="48"
                    CornerRadius="10"
                    Clicked="OnCancelClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
