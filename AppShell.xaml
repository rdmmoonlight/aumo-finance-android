<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:auth="clr-namespace:AumoFinance.Pages.Auth"
       xmlns:main="clr-namespace:AumoFinance.Pages.Main"
       x:Class="AumoFinance.AppShell"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="#0F172A"
       Shell.NavBarIsVisible="False"
       BackgroundColor="#0F172A">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="Button" x:Key="FlyoutMenuItemStyle">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#E2E8F0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Halaman Login (Halaman Awal saat Startup) -->
    <ShellContent
        Title="Login"
        Route="LoginPage"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Shell.FlyoutItemIsVisible="False"
        Shell.FlyoutBehavior="Disabled" />

    <!-- Halaman Utama Aplikasi -->
    <ShellContent
        Title="Home"
        Route="MainPage"
        ContentTemplate="{DataTemplate main:MainPage}" />

    <!-- TAMPILAN MENU DRAWER (FLYOUT CONTENT) -->
    <Shell.FlyoutContent>
        <Grid RowDefinitions="*, Auto" BackgroundColor="#0F172A">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="0,8" Spacing="2">

                    <Button Text="Dashboard" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnDashboardMenuItemClicked" />

                    <BoxView HeightRequest="1" Color="#334155" Margin="16,6" />
                    <Button Text="Chart of Accounts (COA)" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnCoaMenuItemClicked" />
                    <Button Text="Accounting Periods" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnPeriodsMenuItemClicked" />

                    <BoxView HeightRequest="1" Color="#334155" Margin="16,6" />
                    <Button Text="New Journal Entry" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnJournalEntryMenuItemClicked" />

                    <BoxView HeightRequest="1" Color="#334155" Margin="16,6" />

                    <!-- Reports Group Header (collapsible) -->
                    <Button x:Name="ReportsToggleButton"
                            Text="📊  Reports  ▸"
                            Style="{StaticResource FlyoutMenuItemStyle}"
                            FontAttributes="Bold"
                            Clicked="OnToggleReportsClicked" />

                    <VerticalStackLayout x:Name="ReportsSection" IsVisible="False" Spacing="2">
                        <Button Text="General Journal" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnGeneralJournalMenuItemClicked" />
                        <Button Text="Adjusting Journal" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnAdjustingJournalMenuItemClicked" />
                        <Button Text="General Ledger (Permanent)" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnGlPermanentMenuItemClicked" />
                        <Button Text="General Ledger (Temporary)" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnGlTemporaryMenuItemClicked" />
                        <Button Text="Trial Balance" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnTrialBalanceMenuItemClicked" />
                        <Button Text="Adjusted Trial Balance" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnAdjustedTrialBalanceMenuItemClicked" />
                        <Button Text="Worksheet (10-Column)" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnWorksheetMenuItemClicked" />
                        <Button Text="Income Statement" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnIncomeStatementMenuItemClicked" />
                        <Button Text="Retained Earnings Statement" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnRetainedEarningsMenuItemClicked" />
                        <Button Text="Statement of Financial Position" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnSofpMenuItemClicked" />
                        <Button Text="Closing Journal" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnClosingJournalMenuItemClicked" />
                        <Button Text="Post-Closing Trial Balance" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnPostClosingMenuItemClicked" />
                        <Button Text="Statement of Cash Flows" Padding="32,10" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnCashFlowMenuItemClicked" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#334155" Margin="16,6" />
                    <Button Text="App Settings" Style="{StaticResource FlyoutMenuItemStyle}" Clicked="OnSettingsMenuItemClicked" />
                    <Button Text="Logout" Style="{StaticResource FlyoutMenuItemStyle}" TextColor="#F87171" Clicked="OnLogoutMenuItemClicked" />

                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="1" Padding="20,12" BackgroundColor="#0F172A">
                <BoxView HeightRequest="1" Color="#334155" Margin="0,0,0,8" />
                <Label Text="v1.0.0 - Aumo Finance"
                       FontSize="11"
                       TextColor="#64748B"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutContent>

</Shell>
