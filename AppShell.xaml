<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:AumoFinance.Pages"
       xmlns:dashboard="clr-namespace:AumoFinance.Pages.Dashboard"
       xmlns:journal="clr-namespace:AumoFinance.Pages.JournalEntry"
       x:Class="AumoFinance.AppShell"
       FlyoutBackgroundColor="#0F172A"
       Shell.NavBarIsVisible="False"
       BackgroundColor="#0F172A">

    <!-- Styles untuk Shell Menu Items -->
    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="Element" x:Key="BaseStyle">
                <Setter Property="Shell.BackgroundColor" Value="#0F172A" />
                <Setter Property="Shell.ForegroundColor" Value="White" />
                <Setter Property="Shell.TitleColor" Value="White" />
                <Setter Property="Shell.DisabledColor" Value="#64748B" />
                <Setter Property="Shell.UnselectedColor" Value="#94A3B8" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Header Flyout Menu (UI Custom & BoxView diletakkan di sini) -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,40,20,16" Spacing="8" BackgroundColor="#0F172A">
            <Label Text="Aumo Finance"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White" />
            <Label Text="Personal &amp; Business Accounting"
                   FontSize="12"
                   TextColor="#94A3B8" />
            
            <!-- Pemisah Pembatas Menu -->
            <BoxView HeightRequest="1" 
                     Color="#334155" 
                     Margin="0,12,0,0" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- App Navigation Items -->
    <FlyoutItem Title="Home" Route="MainPage">
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate pages:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Dashboard" Route="DashboardPage">
        <ShellContent Title="Dashboard"
                      ContentTemplate="{DataTemplate dashboard:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="New Journal Entry" Route="JournalEntryPage">
        <ShellContent Title="New Journal Entry"
                      ContentTemplate="{DataTemplate journal:JournalEntryPage}" />
    </FlyoutItem>

    <!-- Footer Flyout Menu (Jika butuh pembatas/keterangan bawah) -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20,16" Spacing="8" BackgroundColor="#0F172A">
            <BoxView HeightRequest="1" 
                     Color="#334155" 
                     Margin="0,0,0,8" />
            <Label Text="v1.0.0 - Aumo Finance"
                   FontSize="11"
                   TextColor="#64748B"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
