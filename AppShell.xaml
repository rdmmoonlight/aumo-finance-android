<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AumoFinance.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:AumoFinance.Pages"
    Shell.NavBarIsVisible="False"
    Title="AumoFinance">

    <ShellContent
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="MainPage" />

    <!-- Daftarkan Rute Master & Reports -->
    <Route Path="CoaPage" Component="{x:Type pages:CoaPage}" />
    <Route Path="PeriodsPage" Component="{x:Type pages:PeriodsPage}" />
    <Route Path="InputJournalPage" Component="{x:Type pages:InputJournalPage}" />
    
    <Route Path="GeneralJournalPage" Component="{x:Type pages:GeneralJournalPage}" />
    <Route Path="GeneralLedgerPermanentPage" Component="{x:Type pages:GeneralLedgerPermanentPage}" />
    <Route Path="GeneralLedgerTemporaryPage" Component="{x:Type pages:GeneralLedgerTemporaryPage}" />
    <Route Path="TrialBalancePage" Component="{x:Type pages:TrialBalancePage}" />
    <Route Path="AdjustingJournalPage" Component="{x:Type pages:AdjustingJournalPage}" />
    <Route Path="WorksheetPage" Component="{x:Type pages:WorksheetPage}" />
    <Route Path="IncomeStatementPage" Component="{x:Type pages:IncomeStatementPage}" />
    <Route Path="RetainedEarningsPage" Component="{x:Type pages:RetainedEarningsPage}" />
    <Route Path="StatementOfFinancialPositionPage" Component="{x:Type pages:StatementOfFinancialPositionPage}" />
    <Route Path="PostClosingTrialBalancePage" Component="{x:Type pages:PostClosingTrialBalancePage}" />

</Shell>
