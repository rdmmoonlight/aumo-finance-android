<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.InputJournalPage"
             Title="Input Jurnal"
             BackgroundColor="#0F172A">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">

            <!-- Title Header -->
            <Label Text="Form Transaksi Baru" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="White" />

            <!-- Field Keterangan -->
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,4">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Keterangan / Memot" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="DescriptionEntry"
                           Placeholder="Contoh: Pembelian ATK Kantor"
                           PlaceholderColor="#64748B"
                           TextColor="White"
                           FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Field Debit -->
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,4">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nominal Debit (Rp)" TextColor="#38BDF8" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="DebitEntry"
                           Placeholder="0"
                           PlaceholderColor="#64748B"
                           Keyboard="Numeric"
                           TextChanged="OnAmountTextChanged"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Field Kredit -->
            <Border BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,4">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nominal Kredit (Rp)" TextColor="#F87171" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="CreditEntry"
                           Placeholder="0"
                           PlaceholderColor="#64748B"
                           Keyboard="Numeric"
                           TextChanged="OnAmountTextChanged"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                <!-- Batal -->
                <Button Grid.Column="0"
                        Text="Batal"
                        Clicked="OnCancelClicked"
                        BackgroundColor="#1E293B"
                        BorderColor="#334155"
                        BorderWidth="1"
                        TextColor="#94A3B8"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50" />

                <!-- Simpan -->
                <Button Grid.Column="1"
                        Text="Simpan Data"
                        Clicked="OnSaveClicked"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
