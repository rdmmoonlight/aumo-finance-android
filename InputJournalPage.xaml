<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AumoFinance.InputJournalPage"
             Title="Journal Entry"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="Journal Entry" FontSize="20" FontAttributes="Bold" TextColor="White" />

            <VerticalStackLayout Spacing="2">
                <DatePicker x:Name="EntryDatePicker" TextColor="White" Format="dd/MM/yyyy" />
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=Black, Dark=White}" />
            </VerticalStackLayout>

            <!-- Baris 1: Debit -->
            <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="DEBIT" TextColor="#38BDF8" FontAttributes="Bold" FontSize="12" />
                    <Picker x:Name="AccountPicker1" Title="Akun" ItemDisplayBinding="{Binding DisplayText}" TextColor="White" />

                    <VerticalStackLayout Spacing="2">
                        <Entry x:Name="DescEntry1" Placeholder="Catatan" TextColor="White" PlaceholderColor="#64748B" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=Black, Dark=White}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Entry x:Name="DebitEntry1" Placeholder="Nominal (Rp)" Keyboard="Numeric" TextColor="#22C55E" PlaceholderColor="#64748B" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=Black, Dark=White}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Baris 2: Kredit -->
            <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="KREDIT" TextColor="#F59E0B" FontAttributes="Bold" FontSize="12" />
                    <Picker x:Name="AccountPicker2" Title="Akun" ItemDisplayBinding="{Binding DisplayText}" TextColor="White" />

                    <VerticalStackLayout Spacing="2">
                        <Entry x:Name="DescEntry2" Placeholder="Catatan" TextColor="White" PlaceholderColor="#64748B" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=Black, Dark=White}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Entry x:Name="CreditEntry2" Placeholder="Nominal (Rp)" Keyboard="Numeric" TextColor="#EF4444" PlaceholderColor="#64748B" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=Black, Dark=White}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Simpan"
                    Clicked="OnSaveJournalClicked"
                    BackgroundColor="#22C55E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
